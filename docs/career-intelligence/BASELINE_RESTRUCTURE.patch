+-/* ============================================================
+-   AUTH
+-============================================================ */
+-
+-async function getAuthenticatedUserId() {
+-  const session =
+-    await auth();
+-
+-  const email =
+-    session?.user?.email;
+-
+-  if (!email) {
+-    throw new Error(
+-      "Not authenticated."
+-    );
+-  }
+-
+-  const result =
+-    await sql`
+-      SELECT id
+-      FROM users
+-      WHERE email=${email}
+-      LIMIT 1
+-    `;
+-
+-  if (
+-    !result.rows.length
+-  ) {
+-    throw new Error(
+-      "Authenticated user was not found."
+-    );
+-  }
+-
+-  return String(
+-    result.rows[0].id
+-  );
+-}
