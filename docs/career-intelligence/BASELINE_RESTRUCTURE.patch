+-/* ============================================================
+-   PROMOTE ROLE
+-============================================================ */
+-
+-async function promoteRole(
+-  roleAssessmentId: string,
+-  userId: string
+-) {
+-  const role =
+-    await getRolePayload(
+-      roleAssessmentId
+-    );
+-
+-  /*
+-   * Preserve original canonical-role behaviour:
+-   *
+-   * If the role was unmatched when assessed,
+-   * candidate_profile_roles.canonical_role_id
+-   * remains NULL.
+-   *
+-   * Repository enrichment is separate and may
+-   * create a proposed canonical role.
+-   */
+-  const originalCanonicalRoleId =
+-    role.canonicalRoleId;
+-
+-  const enrichment =
+-    await enrichCanonicalRepository(
+-      role
+-    );
+-
+-  const profileResult =
+-    await sql`
+-      INSERT INTO candidate_profile_roles (
+-        user_id,
+-        source_role_assessment_id,
+-        canonical_role_id,
+-        organisation_name,
+-        role_title,
+-
+-        from_date,
+-        to_date,
+-
+-        from_date_precision,
+-        to_date_precision,
+-
+-        from_date_original,
+-        to_date_original,
+-
+-        role_description,
+-        engagement_model,
+-        employment_context,
+-        updated_at
+-      )
+-      VALUES (
+-        ${userId},
+-        ${roleAssessmentId},
+-        ${originalCanonicalRoleId},
+-        ${role.organisationName},
+-        ${role.roleTitle},
+-
+-        ${role.fromDate || null},
+-        ${
+-          role.toDatePrecision ===
+-          'ongoing'
+-            ? null
+-            : role.toDate ||
+-              null
+-        },
+-
+-        ${
+-          role.fromDatePrecision ||
+-          'unknown'
+-        },
+-
+-        ${
+-          role.toDatePrecision ||
+-          'unknown'
+-        },
+-
+-        ${
+-          role.fromDateOriginal ||
+-          role.fromDate ||
+-          null
+-        },
+-
+-        ${
+-          role.toDatePrecision ===
+-          'ongoing'
+-            ? 'Present'
+-            : role.toDateOriginal ||
+-              role.toDate ||
+-              null
+-        },
+-
+-        ${role.roleDescription || null},
+-        ${role.engagementModel || null},
+-        ${role.employmentContext || null},
+-        NOW()
+-      )
+-      ON CONFLICT (
+-        source_role_assessment_id
+-      )
+-      DO UPDATE SET
+-        canonical_role_id=
+-          EXCLUDED.canonical_role_id,
+-
+-        organisation_name=
+-          EXCLUDED.organisation_name,
+-
+-        role_title=
+-          EXCLUDED.role_title,
+-
+-        from_date=
+-          EXCLUDED.from_date,
+-
+-        to_date=
+-          EXCLUDED.to_date,
+-
+-        from_date_precision=
+-          EXCLUDED.from_date_precision,
+-
+-        to_date_precision=
+-          EXCLUDED.to_date_precision,
+-
+-        from_date_original=
+-          EXCLUDED.from_date_original,
+-
+-        to_date_original=
+-          EXCLUDED.to_date_original,
+-
+-        role_description=
+-          EXCLUDED.role_description,
+-
+-        engagement_model=
+-          EXCLUDED.engagement_model,
+-
+-        employment_context=
+-          EXCLUDED.employment_context,
+-
+-        updated_at=NOW()
+-
+-      RETURNING id
+-    `;
+-
+-  const profileRoleId =
+-    String(
+-      profileResult.rows[0]
+-        .id
+-    );
+-
+-  /*
+-   * Rebuild promoted capabilities/gaps for
+-   * this profile-role snapshot.
+-   */
+-  await sql`
+-    DELETE FROM candidate_profile_role_capabilities
+-    WHERE candidate_profile_role_id=
+-      ${profileRoleId}
+-  `;
+-
+-  await sql`
+-    DELETE FROM candidate_profile_role_gaps
+-    WHERE candidate_profile_role_id=
+-      ${profileRoleId}
+-  `;
+-
+-  for (
+-    const capability of
+-    role.stagedCapabilities
+-  ) {
+-    const name =
+-      capability
+-        .editedCompetencyName ||
+-      capability
+-        .proposedCompetencyName;
+-
+-    if (
+-      capability
+-        .capabilityStatus ===
+-        "demonstrated" &&
+-      (
+-        capability
+-          .reviewStatus ===
+-          "accepted" ||
+-        capability
+-          .reviewStatus ===
+-          "edited"
+-      )
+-    ) {
+-      const mapped =
+-        enrichment.mappings.find(
+-          (mapping) =>
+-            mapping.capabilityId ===
+-            String(
+-              capability.id
+-            )
+-        );
+-
+-      const competencyId =
+-        capability
+-          .canonicalCompetencyId ||
+-        mapped
+-          ?.competencyId ||
+-        null;
+-
+-      await sql`
+-        INSERT INTO candidate_profile_role_capabilities (
+-          candidate_profile_role_id,
+-          competency_id,
+-          capability_name,
+-          confidence,
+-          evidence,
+-          source_type,
+-          updated_at
+-        )
+-        VALUES (
+-          ${profileRoleId},
+-          ${competencyId},
+-          ${name},
+-          ${capability.confidence || 0},
+-          ${capability.editedEvidence || capability.evidence || null},
+-          ${capability.sourceType || 'assessment'},
+-          NOW()
+-        )
+-      `;
+-
+-      /*
+-       * Candidate knowledge only points at an
+-       * established canonical role when one
+-       * existed on the assessment.
+-       */
+-      if (
+-        originalCanonicalRoleId &&
+-        competencyId
+-      ) {
+-        await sql`
+-          INSERT INTO candidate_knowledge (
+-            user_id,
+-            role_id,
+-            competency_id,
+-            confidence,
+-            updated_at
+-          )
+-          VALUES (
+-            ${userId},
+-            ${originalCanonicalRoleId},
+-            ${competencyId},
+-            ${capability.confidence || 0},
+-            NOW()
+-          )
+-          ON CONFLICT (
+-            user_id,
+-            role_id,
+-            competency_id
+-          )
+-          DO UPDATE SET
+-            confidence=
+-              EXCLUDED.confidence,
+-            updated_at=
+-              NOW()
+-        `;
+-      }
+-    }
+-
+-    if (
+-      capability
+-        .capabilityStatus ===
+-      "gap"
+-    ) {
+-      await sql`
+-        INSERT INTO candidate_profile_role_gaps (
+-          candidate_profile_role_id,
+-          competency_name,
+-          evidence
+-        )
+-        VALUES (
+-          ${profileRoleId},
+-          ${name},
+-          ${capability.evidence || null}
+-        )
+-      `;
+-    }
+-  }
+-
+-  return {
+-    profileRoleId,
+-    repositoryRoleId:
+-      enrichment
+-        .canonicalRoleId,
+-  };
+-}
+-
+-/* ============================================================
+-   SUBMIT ROLE
+-============================================================ */
+-
+-async function handleSubmitRole(
+-  body: any,
+-  userId: string
+-) {
+-  const roleAssessmentId =
+-    String(
+-      body.roleAssessmentId ||
+-        ""
+-    );
+-
+-  if (
+-    !roleAssessmentId
+-  ) {
+-    return NextResponse.json(
+-      {
+-        error:
+-          "roleAssessmentId is required.",
+-      },
+-      {
+-        status: 400,
+-      }
+-    );
+-  }
+-
+-  const assessmentId =
+-    await verifyRoleOwnership(
+-      roleAssessmentId,
+-      userId
+-    );
+-
+-  const openQuestions =
+-    await sql`
+-      SELECT COUNT(*)::int AS count
+-      FROM career_role_questions
+-      WHERE
+-        role_assessment_id=
+-          ${roleAssessmentId}
+-        AND
+-        status='open'
+-    `;
+-
+-  if (
+-    Number(
+-      openQuestions.rows[0]
+-        ?.count || 0
+-    ) > 0
+-  ) {
+-    const role =
+-      await getRolePayload(
+-        roleAssessmentId
+-      );
+-
+-    return NextResponse.json(
+-      {
+-        error:
+-          "Clarification questions must be completed before this role can be submitted.",
+-        requiresFurtherReview:
+-          true,
+-        role,
+-        successGates:
+-          role.successGates,
+-      },
+-      {
+-        status: 409,
+-      }
+-    );
+-  }
+-
+-  const proposedCapabilities =
+-    await sql`
+-      SELECT COUNT(*)::int AS count
+-      FROM career_role_capabilities
+-      WHERE
+-        role_assessment_id=
+-          ${roleAssessmentId}
+-        AND
+-        demonstrated=TRUE
+-        AND
+-        capability_status=
+-          'demonstrated'
+-        AND
+-        review_status=
+-          'proposed'
+-    `;
+-
+-  if (
+-    Number(
+-      proposedCapabilities
+-        .rows[0]
+-        ?.count || 0
+-    ) > 0
+-  ) {
+-    const role =
+-      await getRolePayload(
+-        roleAssessmentId
+-      );
+-
+-    return NextResponse.json(
+-      {
+-        error:
+-          "All demonstrated capabilities must be accepted, edited or rejected before completing the role.",
+-        requiresFurtherReview:
+-          true,
+-        role,
+-        successGates:
+-          role.successGates,
+-      },
+-      {
+-        status: 409,
+-      }
+-    );
+-  }
+-
+-  const roleBeforeCheck =
+-    await getRolePayload(
+-      roleAssessmentId
+-    );
+-
+-  const finalCheck =
+-    await finalSubmissionCheck(
+-      roleBeforeCheck
+-    );
+-
+-  if (
+-    finalCheck
+-      .emergingCapabilities
+-      .length ||
+-    finalCheck
+-      .clarifications
+-      .length
+-  ) {
+-    for (
+-      const capability of
+-      finalCheck
+-        .emergingCapabilities
+-    ) {
+-      const mapped =
+-        await mapCapability(
+-          capability
+-        );
+-
+-      await stageCapability(
+-        {
+-          roleAssessmentId,
+-
+-          competencyId:
+-            mapped.competencyId,
+-
+-          name:
+-            mapped.name,
+-
+-          sourceType:
+-            "final_check",
+-
+-          sourceSection:
+-            "final_submission",
+-
+-          evidence:
+-            capability.evidence,
+-
+-          confidence:
+-            capability.confidence,
+-
+-          demonstrated:
+-            true,
+-
+-          capabilityStatus:
+-            "demonstrated",
+-
+-          assessmentStatus:
+-            "assessed",
+-        }
+-      );
+-    }
+-
+-    await replaceOpenQuestions(
+-      roleAssessmentId,
+-      finalCheck
+-        .clarifications
+-    );
+-
+-    await sql`
+-      UPDATE career_role_assessments
+-      SET
+-        lifecycle_status='in_progress',
+-        updated_at=NOW()
+-      WHERE id=
+-        ${roleAssessmentId}
+-    `;
+-
+-    const role =
+-      await getRolePayload(
+-        roleAssessmentId
+-      );
+-
+-    return NextResponse.json(
+-      {
+-        success: true,
+-
+-        requiresFurtherReview:
+-          true,
+-
+-        message:
+-          "The final consistency check identified additional evidence that requires review.",
+-
+-        role,
+-
+-        successGates:
+-          role.successGates,
+-      }
+-    );
+-  }
+-
+-  /*
+-   * Record only when final check really passes.
+-   */
+-  await recordSuccessGate({
+-    assessmentId,
+-    roleAssessmentId,
+-    gateKey:
+-      "final_submission_check_passed",
+-  });
+-
+-  await promoteRole(
+-    roleAssessmentId,
+-    userId
+-  );
+-
+-  await recordSuccessGate({
+-    assessmentId,
+-    roleAssessmentId,
+-    gateKey:
+-      "role_promoted",
+-  });
+-
+-  await sql`
+-    UPDATE career_role_assessments
+-    SET
+-      lifecycle_status='completed',
+-      completed_at=NOW(),
+-      updated_at=NOW()
+-    WHERE id=
+-      ${roleAssessmentId}
+-  `;
+-
+-  await recordSuccessGate({
+-    assessmentId,
+-    roleAssessmentId,
+-    gateKey:
+-      "role_completed",
+-  });
+-
+-  const completedRole =
+-    await sql`
+-      SELECT sequence_no
+-      FROM career_role_assessments
+-      WHERE id=
+-        ${roleAssessmentId}
+-      LIMIT 1
+-    `;
+-
+-  const sequenceNo =
+-    Number(
+-      completedRole.rows[0]
+-        ?.sequence_no || 0
+-    );
+-
+-  const nextResult =
+-    await sql`
+-      SELECT id
+-      FROM career_role_assessments
+-      WHERE
+-        assessment_id=
+-          ${assessmentId}
+-        AND
+-        sequence_no >
+-          ${sequenceNo}
+-        AND
+-        lifecycle_status <>
+-          'completed'
+-      ORDER BY
+-        sequence_no
+-      LIMIT 1
+-    `;
+-
+-  let nextRole:
+-    any = null;
+-
+-  if (
+-    nextResult.rows.length
+-  ) {
+-    const nextRoleId =
+-      String(
+-        nextResult.rows[0].id
+-      );
+-
+-    const nextOpen =
+-      await sql`
+-        SELECT COUNT(*)::int AS count
+-        FROM career_role_questions
+-        WHERE
+-          role_assessment_id=
+-            ${nextRoleId}
+-          AND
+-          status='open'
+-      `;
+-
+-    const hasOpen =
+-      Number(
+-        nextOpen.rows[0]
+-          ?.count || 0
+-      ) > 0;
+-
+-    await sql`
+-      UPDATE career_role_assessments
+-      SET
+-        lifecycle_status=${
+-          hasOpen
+-            ? 'in_progress'
+-            : 'review_ready'
+-        },
+-        updated_at=NOW()
+-      WHERE id=
+-        ${nextRoleId}
+-    `;
+-
+-    await recordSuccessGate({
+-      assessmentId,
+-      roleAssessmentId:
+-        nextRoleId,
+-      gateKey:
+-        "next_role_activated",
+-    });
+-
+-    if (
+-      !hasOpen
+-    ) {
+-      await recordSuccessGate({
+-        assessmentId,
+-        roleAssessmentId:
+-          nextRoleId,
+-        gateKey:
+-          "clarification_completed",
+-      });
+-    }
+-
+-    nextRole =
+-      await getRolePayload(
+-        nextRoleId
+-      );
+-  }
+-
+-  const remaining =
+-    await sql`
+-      SELECT COUNT(*)::int AS count
+-      FROM career_role_assessments
+-      WHERE
+-        assessment_id=
+-          ${assessmentId}
+-        AND
+-        lifecycle_status <>
+-          'completed'
+-    `;
+-
+-  const remainingCount =
+-    Number(
+-      remaining.rows[0]
+-        ?.count || 0
+-    );
+-
+-  let assessmentCompleted =
+-    false;
+-
+-  if (
+-    remainingCount === 0
+-  ) {
+-    assessmentCompleted =
+-      true;
+-
+-    await sql`
+-      UPDATE career_assessments
+-      SET
+-        status='completed',
+-        completed_at=NOW(),
+-        updated_at=NOW()
+-      WHERE id=
+-        ${assessmentId}
+-    `;
+-
+-    await recordSuccessGate({
+-      assessmentId,
+-      gateKey:
+-        "assessment_completed",
+-    });
+-  }
+-
+-  const finalRole =
+-    await getRolePayload(
+-      roleAssessmentId
+-    );
+-
+-  return NextResponse.json(
+-    {
+-      success: true,
+-
+-      completed: true,
+-
+-      assessmentCompleted,
+-
+-      role:
+-        finalRole,
+-
+-      nextRole,
+-
+-      successGates:
+-        finalRole.successGates,
+-    }
+-  );
+-}
