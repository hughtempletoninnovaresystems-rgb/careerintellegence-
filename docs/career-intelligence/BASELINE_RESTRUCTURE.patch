+-/* ============================================================
+-   CAPABILITY REVIEW
+-============================================================ */
+-
+-async function handleReviewCapability(
+-  body: any,
+-  userId: string
+-) {
+-  const roleAssessmentId =
+-    String(
+-      body.roleAssessmentId ||
+-        ""
+-    );
+-
+-  const capabilityId =
+-    String(
+-      body.capabilityId ||
+-        ""
+-    );
+-
+-  const reviewStatus =
+-    String(
+-      body.reviewStatus ||
+-        ""
+-    ) as ReviewStatus;
+-
+-  if (
+-    !roleAssessmentId ||
+-    !capabilityId
+-  ) {
+-    return NextResponse.json(
+-      {
+-        error:
+-          "roleAssessmentId and capabilityId are required.",
+-      },
+-      {
+-        status: 400,
+-      }
+-    );
+-  }
+-
+-  if (
+-    ![
+-      "accepted",
+-      "edited",
+-      "rejected",
+-    ].includes(
+-      reviewStatus
+-    )
+-  ) {
+-    return NextResponse.json(
+-      {
+-        error:
+-          "Invalid reviewStatus.",
+-      },
+-      {
+-        status: 400,
+-      }
+-    );
+-  }
+-
+-  const assessmentId =
+-    await verifyRoleOwnership(
+-      roleAssessmentId,
+-      userId
+-    );
+-
+-  const capabilityResult =
+-    await sql`
+-      SELECT id
+-      FROM career_role_capabilities
+-      WHERE
+-        id=${capabilityId}
+-        AND
+-        role_assessment_id=
+-          ${roleAssessmentId}
+-      LIMIT 1
+-    `;
+-
+-  if (
+-    !capabilityResult
+-      .rows.length
+-  ) {
+-    return NextResponse.json(
+-      {
+-        error:
+-          "Capability not found.",
+-      },
+-      {
+-        status: 404,
+-      }
+-    );
+-  }
+-
+-  await sql`
+-    UPDATE career_role_capabilities
+-    SET
+-      review_status=
+-        ${reviewStatus},
+-
+-      edited_competency_name=${
+-        reviewStatus ===
+-        'edited'
+-          ? String(
+-              body.competencyName ||
+-                ""
+-            ).trim() ||
+-            null
+-          : null
+-      },
+-
+-      edited_evidence=${
+-        reviewStatus ===
+-        'edited'
+-          ? String(
+-              body.evidence ||
+-                ""
+-            ).trim() ||
+-            null
+-          : null
+-      },
+-
+-      updated_at=NOW()
+-
+-    WHERE id=
+-      ${capabilityId}
+-  `;
+-
+-  await recordSuccessGate({
+-    assessmentId,
+-    roleAssessmentId,
+-    gateKey:
+-      "capability_review_completed",
+-    metadata: {
+-      capabilityId,
+-      reviewStatus,
+-    },
+-  });
+-
+-  const remaining =
+-    await sql`
+-      SELECT COUNT(*)::int AS count
+-      FROM career_role_capabilities
+-      WHERE
+-        role_assessment_id=
+-          ${roleAssessmentId}
+-        AND
+-        demonstrated=TRUE
+-        AND
+-        capability_status=
+-          'demonstrated'
+-        AND
+-        review_status=
+-          'proposed'
+-    `;
+-
+-  if (
+-    Number(
+-      remaining.rows[0]
+-        ?.count || 0
+-    ) === 0
+-  ) {
+-    await recordSuccessGate({
+-      assessmentId,
+-      roleAssessmentId,
+-      gateKey:
+-        "all_demonstrated_capabilities_reviewed",
+-    });
+-  }
+-
+-  const role =
+-    await getRolePayload(
+-      roleAssessmentId
+-    );
+-
+-  return NextResponse.json(
+-    {
+-      success: true,
+-      role,
+-      successGates:
+-        role.successGates,
+-    }
+-  );
+-}
+-
+-/* ============================================================
+-   UPDATE ROLE CONTEXT
+-============================================================ */
+-
+-async function handleUpdateRole(
+-  body: any,
+-  userId: string
+-) {
+-  const roleAssessmentId =
+-    String(
+-      body.roleAssessmentId ||
+-        ""
+-    );
+-
+-  if (
+-    !roleAssessmentId
+-  ) {
+-    return NextResponse.json(
+-      {
+-        error:
+-          "roleAssessmentId is required.",
+-      },
+-      {
+-        status: 400,
+-      }
+-    );
+-  }
+-
+-  const assessmentId =
+-    await verifyRoleOwnership(
+-      roleAssessmentId,
+-      userId
+-    );
+-
+-  const organisationName =
+-    String(
+-      body.organisationName ||
+-        ""
+-    ).trim();
+-
+-  const roleTitle =
+-    String(
+-      body.roleTitle ||
+-        ""
+-    ).trim();
+-
+-  const roleDescription =
+-    String(
+-      body.roleDescription ||
+-        ""
+-    ).trim();
+-
+-  if (
+-    !organisationName ||
+-    !roleTitle ||
+-    !roleDescription
+-  ) {
+-    return NextResponse.json(
+-      {
+-        error:
+-          "Organisation, role title and role description are required.",
+-      },
+-      {
+-        status: 400,
+-      }
+-    );
+-  }
+-
+-  const canonical =
+-    await findCanonicalRole(
+-      roleTitle
+-    );
+-
+-  const fromDate =
+-    body.fromDate ||
+-    null;
+-
+-  const toDatePrecision =
+-    String(
+-      body.toDatePrecision ||
+-        (
+-          body.toDate
+-            ? "day"
+-            : "unknown"
+-        )
+-    );
+-
+-  const toDate =
+-    toDatePrecision ===
+-    "ongoing"
+-      ? null
+-      : body.toDate ||
+-        null;
+-
+-  await sql`
+-    UPDATE career_role_assessments
+-    SET
+-      canonical_role_id=${
+-        canonical
+-          ? String(
+-              canonical.id
+-            )
+-          : null
+-      },
+-
+-      organisation_name=
+-        ${organisationName},
+-
+-      proposed_role_title=
+-        ${roleTitle},
+-
+-      from_date=
+-        ${fromDate},
+-
+-      to_date=
+-        ${toDate},
+-
+-      from_date_precision=${
+-        body.fromDatePrecision ||
+-        (
+-          fromDate
+-            ? 'day'
+-            : 'unknown'
+-        )
+-      },
+-
+-      to_date_precision=
+-        ${toDatePrecision},
+-
+-      from_date_original=${
+-        body.fromDateOriginal ||
+-        fromDate ||
+-        null
+-      },
+-
+-      to_date_original=${
+-        toDatePrecision ===
+-        'ongoing'
+-          ? 'Present'
+-          : body.toDateOriginal ||
+-            toDate ||
+-            null
+-      },
+-
+-      role_description=
+-        ${roleDescription},
+-
+-      engagement_model=${
+-        body.engagementModel ||
+-        null
+-      },
+-
+-      employment_context=${
+-        body.employmentContext ||
+-        null
+-      },
+-
+-      updated_at=NOW()
+-
+-    WHERE id=
+-      ${roleAssessmentId}
+-  `;
+-
+-  await recordSuccessGate({
+-    assessmentId,
+-    roleAssessmentId,
+-    gateKey:
+-      "role_context_updated",
+-  });
+-
+-  const role =
+-    await getRolePayload(
+-      roleAssessmentId
+-    );
+-
+-  return NextResponse.json(
+-    {
+-      success: true,
+-      role,
+-      successGates:
+-        role.successGates,
+-    }
+-  );
+-}
+-
+-/* ============================================================
+-   FINAL SUBMISSION CHECK
+-============================================================ */
+-
+-async function finalSubmissionCheck(
+-  rolePayload: any
+-): Promise<{
+-  emergingCapabilities:
+-    ExtractedCapability[];
+-  clarifications: Gap[];
+-}> {
+-  const prompt = `
+-Perform a final consistency check on this career role before it is promoted to the candidate profile.
+-
+-Return JSON only:
+-
+-{
+-  "emergingCapabilities": [
+-    {
+-      "name": "",
+-      "evidence": "",
+-      "confidence": 0.0
+-    }
+-  ],
+-  "clarifications": [
+-    {
+-      "competency": "",
+-      "reason": "",
+-      "question": ""
+-    }
+-  ]
+-}
+-
+-Rules:
+-
+-- Look across the role context, accepted/edited capabilities, rejected capabilities and clarification evidence.
+-- Identify an emerging capability only where evidence genuinely supports it.
+-- If there is a plausible capability signal but insufficient evidence, return a clarification question.
+-- Do not reopen rejected capabilities without new evidence.
+-- Do not duplicate capabilities already represented.
+-- A keyword alone is insufficient evidence.
+-- Return empty arrays when no further work is required.
+-
+-Role:
+-${JSON.stringify(
+-  rolePayload
+-)}
+-`;
+-
+-  const response =
+-    await ai.models.generateContent(
+-      {
+-        model: MODEL,
+-        contents: prompt,
+-      }
+-    );
+-
+-  const parsed =
+-    JSON.parse(
+-      cleanJson(
+-        geminiText(
+-          response
+-        )
+-      )
+-    );
+-
+-  const emergingCapabilities =
+-    Array.isArray(
+-      parsed
+-        ?.emergingCapabilities
+-    )
+-      ? parsed.emergingCapabilities
+-      : [];
+-
+-  const clarifications =
+-    Array.isArray(
+-      parsed?.clarifications
+-    )
+-      ? parsed.clarifications
+-      : [];
+-
+-  return {
+-    emergingCapabilities:
+-      emergingCapabilities
+-        .filter(
+-          (item: any) =>
+-            typeof item
+-              ?.name ===
+-              "string" &&
+-            item.name.trim()
+-        )
+-        .map(
+-          (item: any) => ({
+-            name:
+-              item.name.trim(),
+-
+-            evidence:
+-              typeof item
+-                .evidence ===
+-              "string"
+-                ? item.evidence.trim()
+-                : "",
+-
+-            confidence:
+-              clamp(
+-                Number(
+-                  item.confidence ||
+-                    0
+-                )
+-              ),
+-          })
+-        ),
+-
+-    clarifications:
+-      clarifications
+-        .filter(
+-          (item: any) =>
+-            typeof item
+-              ?.competency ===
+-              "string" &&
+-            item.competency.trim() &&
+-            typeof item
+-              ?.question ===
+-              "string" &&
+-            item.question.trim()
+-        )
+-        .map(
+-          (item: any) => ({
+-            competency:
+-              item.competency.trim(),
+-
+-            reason:
+-              typeof item
+-                .reason ===
+-              "string"
+-                ? item.reason.trim()
+-                : "Additional evidence is required.",
+-
+-            question:
+-              item.question.trim(),
+-          })
+-        ),
+-  };
+-}
