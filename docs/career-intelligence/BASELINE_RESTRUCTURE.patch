-
-async function recordSuccessGate({
-  assessmentId,
-  roleAssessmentId = null,
-  gateKey,
-  metadata = {},
-}: {
-  assessmentId: string;
-  roleAssessmentId?: string | null;
-  gateKey: string;
-  metadata?: Record<
-    string,
-    unknown
-  >;
-}) {
-  try {
-    const scopeKey =
-      roleAssessmentId
-        ? `role:${roleAssessmentId}`
-        : `assessment:${assessmentId}`;
-
-    await sql`
-      INSERT INTO career_success_gates (
-        assessment_id,
-        role_assessment_id,
-        scope_key,
-        gate_key,
-        status,
-        metadata,
-        achieved_at,
-        created_at,
-        updated_at
-      )
-      VALUES (
-        ${assessmentId},
-        ${roleAssessmentId},
-        ${scopeKey},
-        ${gateKey},
-        'achieved',
-        CAST(
-          ${JSON.stringify(
-            metadata
-          )}
-          AS jsonb
-        ),
-        NOW(),
-        NOW(),
-        NOW()
-      )
-      ON CONFLICT (
-        scope_key,
-        gate_key
-      )
-      DO UPDATE SET
-        status='achieved',
-        metadata=
-          EXCLUDED.metadata,
-        achieved_at=
-          NOW(),
-        updated_at=
-          NOW()
-    `;
-  } catch (error) {
-    console.error(
-      "Unable to record success gate:",
-      gateKey,
-      error
-    );
-  }
-}
