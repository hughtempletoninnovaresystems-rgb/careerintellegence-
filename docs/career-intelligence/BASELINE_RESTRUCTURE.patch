++        ${assessmentId},
++        ${roleAssessmentId},
++        ${scopeKey},
++        ${gateKey},
++        'achieved',
++        CAST(${JSON.stringify(metadata)} AS jsonb),
++        NOW(),
++        NOW(),
++        NOW()
++      )
++      ON CONFLICT (scope_key, gate_key)
++      DO UPDATE SET
++        status='achieved',
++        metadata=EXCLUDED.metadata,
++        achieved_at=NOW(),
++        updated_at=NOW()
