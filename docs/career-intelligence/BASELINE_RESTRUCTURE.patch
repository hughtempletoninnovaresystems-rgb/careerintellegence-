+
+async function handleStartManual(
+  body: any,
+  userId: string
+) {
+  const roles =
+    Array.isArray(
+      body.roles
+    )
+      ? body.roles
+      : [];
+
+  if (
+    !roles.length
+  ) {
+    return NextResponse.json(
+      {
+        error:
+          "At least one role is required.",
+      },
+      {
+        status: 400,
+      }
+    );
+  }
+
+  for (
+    const role of roles
+  ) {
+    if (
+      !String(
+        role.organisation ||
+          ""
+      ).trim() ||
+      !String(
+        role.roleTitle ||
+          ""
+      ).trim() ||
+      !String(
+        role.description ||
+          ""
+      ).trim()
+    ) {
+      return NextResponse.json(
+        {
+          error:
+            "Organisation, role title and role description are required for every role.",
+        },
+        {
+          status: 400,
+        }
+      );
+    }
+  }
+
+  const assessmentId =
+    await createAssessment(
+      userId
+    );
+
+  await recordSuccessGate({
+    assessmentId,
+    gateKey:
+      "assessment_started",
+    metadata: {
+      sourceType:
+        "manual",
+    },
+  });
+
+  await recordSuccessGate({
+    assessmentId,
+    gateKey:
+      "roles_entered",
+    metadata: {
+      count:
+        roles.length,
+    },
+  });
+
+  const createdRoles: any[] =
+    [];
+
+  for (
+    let index = 0;
+    index < roles.length;
+    index++
+  ) {
+    const input =
+      roles[index];
+
+    const role:
+      ManualRoleInput = {
+      organisation:
+        String(
+          input.organisation ||
+            ""
+        ).trim(),
+
+      roleTitle:
+        String(
+          input.roleTitle ||
+            ""
+        ).trim(),
+
+      fromDate:
+        input.fromDate ||
+        null,
+
+      toDate:
+        input.toDatePrecision ===
+        "ongoing"
+          ? null
+          : input.toDate ||
+            null,
+
+      fromDatePrecision:
+        input.fromDatePrecision ||
+        (
+          input.fromDate
+            ? "day"
+            : "unknown"
+        ),
+
+      toDatePrecision:
+        input.toDatePrecision ===
+        "ongoing"
+          ? "ongoing"
+          : input.toDatePrecision ||
+            (
+              input.toDate
+                ? "day"
+                : "unknown"
+            ),
+
+      fromDateOriginal:
+        input.fromDateOriginal ||
+        input.fromDate ||
+        null,
+
+      toDateOriginal:
+        input.toDatePrecision ===
+        "ongoing"
+          ? "Present"
+          : input.toDateOriginal ||
+            input.toDate ||
+            null,
+
+      description:
+        String(
+          input.description ||
+            ""
+        ).trim(),
+
+      engagementType:
+        input.engagementType ||
+        null,
+
+      employmentType:
+        input.employmentType ||
+        null,
+    };
+
+    const canonical =
+      await findCanonicalRole(
+        role.roleTitle
+      );
+
+    const roleAssessmentId =
+      await createRoleAssessment(
+        assessmentId,
+        index + 1,
+        role,
+        canonical
+          ? String(
+              canonical.id
+            )
+          : null,
+        index === 0
+          ? "in_progress"
+          : "not_started"
+      );
+
+    await recordSuccessGate({
+      assessmentId,
+      roleAssessmentId,
+      gateKey:
+        "role_created",
+      metadata: {
+        sequenceNo:
+          index + 1,
+      },
+    });
+
+    const analysis =
+      await analyseManualRole(
+        role,
+        canonical
+          ? String(
+              canonical.id
+            )
+          : null
+      );
+
+    for (
+      const capability of
+      analysis.capabilities
+    ) {
+      const canonicalCompetency =
+        await findCompetency(
+          capability.name
+        );
+
+      await stageCapability(
+        {
+          roleAssessmentId,
+
+          competencyId:
+            canonicalCompetency
+              ? String(
+                  canonicalCompetency.id
+                )
+              : null,
+
+          name:
+            canonicalCompetency
+              ? String(
+                  canonicalCompetency.name
+                )
+              : capability.name,
+
+          sourceType:
+            "manual_role",
+
+          evidence:
+            capability.evidence,
+
+          confidence:
+            capability.confidence,
+
+          demonstrated:
+            true,
+
+          capabilityStatus:
+            "demonstrated",
+
+          assessmentStatus:
+            "assessed",
+        }
+      );
+    }
+
+    await replaceOpenQuestions(
+      roleAssessmentId,
+      analysis.gaps
+    );
+
+    if (
+      index === 0 &&
+      !analysis.gaps.length
+    ) {
+      await transitionRoleLifecycle({
+        roleAssessmentId,
+        to: "review_ready",
+      });
+
+      await recordSuccessGate({
+        assessmentId,
+        roleAssessmentId,
+        gateKey:
+          "clarification_completed",
+      });
+    }
+
+    await recordSuccessGate({
+      assessmentId,
+      roleAssessmentId,
+      gateKey:
+        "role_analysis_completed",
+      metadata: {
+        capabilities:
+          analysis
+            .capabilities
+            .length,
+
+        questions:
+          analysis
+            .gaps
+            .length,
+      },
+    });
+
+    createdRoles.push(
+      await getRolePayload(
+        roleAssessmentId
+      )
+    );
+  }
+
+  const successGates =
+    await getSuccessGates(
+      assessmentId
+    );
+
+  return NextResponse.json(
+    {
+      success: true,
+      assessmentId,
+      roles:
