+    successGates: role.successGates,
+  });
+}
+
+/* ============================================================
+   POST
+============================================================ */
+
+export async function POST(
+  request: Request
+) {
+  const correlationId =
+    getCorrelationId(request);
+
+  try {
+    const userId =
+      await getAuthenticatedUserId();
+
+    const contentType =
+      request.headers.get(
+        "content-type"
+      ) || "";
+
+    /*
+     * Multipart = CV upload.
+     */
+    if (
+      contentType.includes(
+        "multipart/form-data"
+      )
+    ) {
+      return withCorrelationId(
+        await handleCVUpload(
+          request,
+          userId
+        ),
+        correlationId
+      );
+    }
+
+    let rawBody: unknown;
+
+    try {
+      rawBody =
+        await request.json();
+    } catch {
+      return NextResponse.json(
+        {
+          error:
+            "Invalid JSON request.",
+          correlationId,
+        },
+        {
+          status: 400,
+          headers: {
+            "x-correlation-id":
+              correlationId,
+          },
+        }
+      );
+    }
+
+    const parsed =
+      analyseCvActionSchema.safeParse(
+        rawBody
+      );
+
+    if (!parsed.success) {
+      return NextResponse.json(
+        {
+          error:
+            "Invalid request payload.",
+          correlationId,
+        },
+        {
+          status: 400,
+          headers: {
+            "x-correlation-id":
+              correlationId,
+          },
+        }
+      );
+    }
+
+    const body =
+      parsed.data;
+
+    switch (
+      body.action
+    ) {
+      case "assess_role":
+        return withCorrelationId(
+          await handleAssessRole(
+            body,
+            userId
+          ),
+          correlationId
+        );
+
+      case "review_capability":
+        return withCorrelationId(
+          await handleReviewCapability(
+            body,
+            userId
+          ),
+          correlationId
+        );
+
+      case "update_role_context":
+        return withCorrelationId(
+          await handleUpdateRole(
+            body,
+            userId
+          ),
+          correlationId
+        );
+
+      case "submit_role":
+        return withCorrelationId(
+          await handleSubmitRole(
+            body,
+            userId
+          ),
+          correlationId
+        );
+    }
+  } catch (error) {
+    return errorResponse(
+      error,
+      correlationId
+    );
+  }
 }
