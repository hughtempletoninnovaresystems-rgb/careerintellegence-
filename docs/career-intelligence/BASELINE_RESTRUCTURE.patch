+-/* ============================================================
+-   CAPABILITY REVIEW
+-============================================================ */
+-
+-async function handleReviewCapability(
+-  body: any,
+-  userId: string
+-) {
+-  const roleAssessmentId =
+-    String(
+-      body.roleAssessmentId ||
+-        ""
+-    );
+-
+-  const capabilityId =
+-    String(
+-      body.capabilityId ||
+-        ""
+-    );
+-
+-  const action =
+-    String(
+-      body.action ||
+-        ""
+-    );
+-
+-  const assessmentId =
+-    await verifyRoleOwnership(
+-      roleAssessmentId,
+-      userId
+-    );
+-
+-  let reviewStatus:
+-    ReviewStatus;
+-
+-  switch (action) {
+-    case "accept":
+-      reviewStatus =
+-        "accepted";
+-      break;
+-
+-    case "reject":
+-      reviewStatus =
+-        "rejected";
+-      break;
+-
+-    case "edit":
+-      reviewStatus =
+-        "edited";
+-      break;
+-
+-    default:
+-      return NextResponse.json(
+-        {
+-          error:
+-            "Invalid capability review action.",
+-        },
+-        {
+-          status: 400,
+-        }
+-      );
+-  }
+-
+-  await sql`
+-    UPDATE career_role_capabilities
+-    SET
+-      review_status=
+-        ${reviewStatus},
+-
+-      edited_competency_name=${
+-        reviewStatus ===
+-        'edited'
+-          ? String(
+-              body.name ||
+-                ""
+-            ).trim() ||
+-            null
+-          : null
+-      },
+-
+-      edited_evidence=${
+-        reviewStatus ===
+-        'edited'
+-          ? String(
+-              body.evidence ||
+-                ""
+-            ).trim() ||
+-            null
+-          : null
+-      },
+-
+-      updated_at=NOW()
+-
+-    WHERE
+-      id=${capabilityId}
+-      AND
+-      role_assessment_id=
+-        ${roleAssessmentId}
+-  `;
+-
+-  await recordSuccessGate({
+-    assessmentId,
+-    roleAssessmentId,
+-    gateKey:
+-      "capability_review_completed",
+-    metadata: {
+-      capabilityId,
+-      reviewStatus,
+-    },
+-  });
+-
+-  const remaining =
+-    await sql`
+-      SELECT COUNT(*)::int AS count
+-      FROM career_role_capabilities
+-      WHERE
+-        role_assessment_id=
+-          ${roleAssessmentId}
+-        AND
+-        demonstrated=TRUE
+-        AND
+-        capability_status=
+-          'demonstrated'
+-        AND
+-        review_status=
+-          'proposed'
+-    `;
+-
+-  if (
+-    Number(
+-      remaining.rows[0]
+-        ?.count || 0
+-    ) === 0
+-  ) {
+-    await recordSuccessGate({
+-      assessmentId,
+-      roleAssessmentId,
+-      gateKey:
+-        "all_demonstrated_capabilities_reviewed",
+-    });
+-  }
+-
+-  const role =
+-    await getRolePayload(
+-      roleAssessmentId
+-    );
+-
+-  return NextResponse.json(
+-    {
+-      success: true,
+-      role,
+-      successGates:
+-        role.successGates,
+-    }
+-  );
+-}
