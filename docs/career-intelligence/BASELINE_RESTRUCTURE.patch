+-async function stageCapability({
+-  roleAssessmentId,
+-  competencyId = null,
+-  name,
+-  sourceType,
+-  evidence,
+-  confidence,
+-  demonstrated,
+-  capabilityStatus,
+-  assessmentStatus,
+-}: {
+-  roleAssessmentId: string;
+-  competencyId?: string | null;
+-  name: string;
+-  sourceType: string;
+-  evidence: string;
+-  confidence: number;
+-  demonstrated: boolean;
+-  capabilityStatus: CapabilityStatus;
+-  assessmentStatus: AssessmentStatus;
+-}) {
+-  await sql`
+-    INSERT INTO career_role_capabilities (
+-      role_assessment_id,
+-      canonical_competency_id,
+-      proposed_competency_name,
+-      source_type,
+-      evidence,
+-      ai_confidence,
+-      demonstrated,
+-      capability_status,
+-      assessment_status,
+-      review_status,
+-      created_at,
+-      updated_at
+-    )
+-    VALUES (
+-      ${roleAssessmentId},
+-      ${competencyId},
+-      ${name},
+-      ${sourceType},
+-      ${evidence || null},
+-      ${clamp(confidence)},
+-      ${demonstrated},
+-      ${capabilityStatus},
+-      ${assessmentStatus},
+-      'proposed',
+-      NOW(),
+-      NOW()
+-    )
+-  `;
+-}
+-
+-async function replaceOpenQuestions(
+-  roleAssessmentId: string,
+-  gaps: Gap[]
+-) {
+-  if (
+-    !gaps.length
+-  ) {
+-    return;
+-  }
+-
+-  const roundResult =
+-    await sql`
+-      SELECT
+-        COALESCE(
+-          MAX(round_no),
+-          0
+-        ) AS max_round
+-      FROM career_role_questions
+-      WHERE role_assessment_id=
+-        ${roleAssessmentId}
+-    `;
+-
+-  const roundNo =
+-    Number(
+-      roundResult.rows[0]
+-        ?.max_round || 0
+-    ) + 1;
+-
+-  for (
+-    const gap of gaps
+-  ) {
+-    await sql`
+-      INSERT INTO career_role_questions (
+-        role_assessment_id,
+-        round_no,
+-        competency,
+-        reason,
+-        question,
+-        status,
+-        created_at,
+-        updated_at
+-      )
+-      VALUES (
+-        ${roleAssessmentId},
+-        ${roundNo},
+-        ${gap.competency},
+-        ${gap.reason},
+-        ${gap.question},
+-        'open',
+-        NOW(),
+-        NOW()
+-      )
+-    `;
+-  }
+-}
