-): Promise<Gap[]> {
-  const expected =
-    await getRoleCompetencies(
-      canonicalRoleId
-    );
-
-  const gaps =
-    expected.filter(
-      (competency) =>
-        !role.capabilities.some(
-          (capability) =>
-            nameMatches(
-              capability.name,
-              String(
-                competency.name
-              )
-            )
-        )
-    );
-
