-
-async function getRoleCompetencies(
-  roleId: string
-) {
-  const result =
-    await sql`
-      SELECT
-        c.id,
-        c.name,
-        rc.importance
-      FROM role_competencies rc
-      INNER JOIN competencies c
-        ON c.id=
-          rc.competency_id
-      WHERE
-        rc.role_id=
-          ${roleId}
-        AND
-        COALESCE(
-          rc.lifecycle_status,
-          'approved'
-        ) <> 'rejected'
-      ORDER BY
-        rc.importance DESC NULLS LAST,
-        c.name
-    `;
-
-  return result.rows;
-}
