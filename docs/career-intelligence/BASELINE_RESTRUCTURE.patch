-/* ============================================================
-   EVALUATE CLARIFICATION
-============================================================ */
-
-async function evaluateAnswers(
-  role: any,
-  answers: any[]
-): Promise<Evaluation[]> {
-  const prompt = `
-Evaluate candidate clarification evidence.
-
-Return JSON only:
-
-{
-  "evaluations": [
-    {
-      "questionId": "",
-      "competency": "",
-      "status": "demonstrated | gap | needs_clarification",
-      "evidence": "",
-      "confidence": 0.0,
-      "followUpQuestion": "",
-      "followUpReason": "",
-      "emergingCapabilities": [
-        {
-          "name": "",
-          "evidence": "",
-          "confidence": 0.0
-        }
-      ]
-    }
-  ]
-}
-
-Rules:
-
-- Demonstrated requires evidence of what the candidate actually did.
-- A capability keyword alone is insufficient.
-- A new signal may reveal an additional capability.
-- If the new signal lacks evidence, return a follow-up clarification.
-- Do not invent evidence.
-- Confidence must be 0 to 1.
-
-Role:
-${JSON.stringify(
-  role
-)}
-
-Answers:
-${JSON.stringify(
-  answers
-)}
-`;
-
-  const response =
-    await ai.models.generateContent(
-      {
-        model: MODEL,
-        contents: prompt,
-      }
-    );
-
-  const parsed =
-    JSON.parse(
-      cleanJson(
-        geminiText(
-          response
-        )
-      )
-    );
-
-  const evaluations =
-    Array.isArray(
-      parsed?.evaluations
-    )
-      ? parsed.evaluations
-      : [];
-
-  return evaluations.map(
-    (evaluation: any) => ({
-      questionId:
-        String(
-          evaluation.questionId ||
-            ""
-        ),
-
-      competency:
-        String(
-          evaluation.competency ||
-            ""
-        ),
-
-      status:
-        [
-          "demonstrated",
-          "gap",
-          "needs_clarification",
-        ].includes(
-          evaluation.status
-        )
-          ? evaluation.status
-          : "needs_clarification",
-
-      evidence:
-        String(
-          evaluation.evidence ||
-            ""
-        ),
-
-      confidence:
-        clamp(
-          Number(
-            evaluation.confidence ||
-              0
-          )
-        ),
-
-      followUpQuestion:
-        evaluation.followUpQuestion ||
-        undefined,
-
-      followUpReason:
-        evaluation.followUpReason ||
-        undefined,
-
-      emergingCapabilities:
-        Array.isArray(
-          evaluation
-            .emergingCapabilities
-        )
-          ? evaluation
-              .emergingCapabilities
-              .map(
-                (
-                  item: any
-                ) => ({
-                  name:
-                    String(
-                      item.name ||
-                        ""
-                    ).trim(),
-
-                  evidence:
-                    String(
-                      item.evidence ||
-                        ""
-                    ).trim(),
-
-                  confidence:
-                    clamp(
-                      Number(
-                        item.confidence ||
-                          0
-                      )
-                    ),
-                })
-              )
-              .filter(
-                (
-                  item: any
-                ) =>
-                  item.name
-              )
-          : [],
-    })
-  );
-}
