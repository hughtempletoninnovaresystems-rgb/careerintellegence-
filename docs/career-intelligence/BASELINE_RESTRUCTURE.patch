+-/* ============================================================
+-   PROMOTE
+-============================================================ */
+-
+-async function promoteRole(
+-  roleAssessmentId: string,
+-  userId: string
+-) {
+-  const role =
+-    await getRolePayload(
+-      roleAssessmentId
+-    );
+-
+-  const originalCanonicalRoleId =
+-    role.canonicalRoleId;
+-
+-  const repositoryRoleId =
+-    await getOrCreateCanonicalRole(
+-      role.roleTitle,
+-      role.description
+-    );
+-
+-  const competencyMappings =
+-    new Map<
+-      string,
+-      string
+-    >();
+-
+-  for (
+-    const capability of
+-    role.capabilities
+-  ) {
+-    if (
+-      capability
+-        .capabilityStatus !==
+-        "demonstrated" ||
+-      (
+-        capability
+-          .reviewStatus !==
+-          "accepted" &&
+-        capability
+-          .reviewStatus !==
+-          "edited"
+-      )
+-    ) {
+-      continue;
+-    }
+-
+-    const name =
+-      capability
+-        .reviewStatus ===
+-        "edited" &&
+-      capability.editedName
+-        ? capability.editedName
+-        : capability.name;
+-
+-    const competencyId =
+-      capability
+-        .competencyId ||
+-      await getOrCreateCanonicalCompetency(
+-        name
+-      );
+-
+-    competencyMappings.set(
+-      capability.id,
+-      competencyId
+-    );
+-
+-    await ensureRoleCompetency(
+-      repositoryRoleId,
+-      competencyId
+-    );
+-  }
+-
+-  const profile =
+-    await sql`
+-      INSERT INTO candidate_profile_roles (
+-        user_id,
+-        source_role_assessment_id,
+-        canonical_role_id,
+-        organisation_name,
+-        role_title,
+-
+-        from_date,
+-        to_date,
+-
+-        from_date_precision,
+-        to_date_precision,
+-
+-        from_date_original,
+-        to_date_original,
+-
+-        role_description,
+-        engagement_model,
+-        employment_context,
+-        updated_at
+-      )
+-      VALUES (
+-        ${userId},
+-        ${roleAssessmentId},
+-        ${originalCanonicalRoleId},
+-        ${role.organisation},
+-        ${role.roleTitle},
+-
+-        ${role.fromDate || null},
+-
+-        ${
+-          role.toDatePrecision ===
+-          'ongoing'
+-            ? null
+-            : role.toDate ||
+-              null
+-        },
+-
+-        ${
+-          role.fromDatePrecision ||
+-          'unknown'
+-        },
+-
+-        ${
+-          role.toDatePrecision ||
+-          'unknown'
+-        },
+-
+-        ${
+-          role.fromDateOriginal ||
+-          role.fromDate ||
+-          null
+-        },
+-
+-        ${
+-          role.toDatePrecision ===
+-          'ongoing'
+-            ? 'Present'
+-            : role.toDateOriginal ||
+-              role.toDate ||
+-              null
+-        },
+-
+-        ${role.description || null},
+-        ${role.engagementType || null},
+-        ${role.employmentType || null},
+-        NOW()
+-      )
+-      ON CONFLICT (
+-        source_role_assessment_id
+-      )
+-      DO UPDATE SET
+-        canonical_role_id=
+-          EXCLUDED.canonical_role_id,
+-
+-        organisation_name=
+-          EXCLUDED.organisation_name,
+-
+-        role_title=
+-          EXCLUDED.role_title,
+-
+-        from_date=
+-          EXCLUDED.from_date,
+-
+-        to_date=
+-          EXCLUDED.to_date,
+-
+-        from_date_precision=
+-          EXCLUDED.from_date_precision,
+-
+-        to_date_precision=
+-          EXCLUDED.to_date_precision,
+-
+-        from_date_original=
+-          EXCLUDED.from_date_original,
+-
+-        to_date_original=
+-          EXCLUDED.to_date_original,
+-
+-        role_description=
+-          EXCLUDED.role_description,
+-
+-        engagement_model=
+-          EXCLUDED.engagement_model,
+-
+-        employment_context=
+-          EXCLUDED.employment_context,
+-
+-        updated_at=
+-          NOW()
+-
+-      RETURNING id
+-    `;
+-
+-  const profileRoleId =
+-    String(
+-      profile.rows[0].id
+-    );
+-
+-  await sql`
+-    DELETE FROM candidate_profile_role_capabilities
+-    WHERE candidate_profile_role_id=
+-      ${profileRoleId}
+-  `;
+-
+-  await sql`
+-    DELETE FROM candidate_profile_role_gaps
+-    WHERE candidate_profile_role_id=
+-      ${profileRoleId}
+-  `;
+-
+-  for (
+-    const capability of
+-    role.capabilities
+-  ) {
+-    const name =
+-      capability
+-        .reviewStatus ===
+-        "edited" &&
+-      capability.editedName
+-        ? capability.editedName
+-        : capability.name;
+-
+-    const evidence =
+-      capability
+-        .reviewStatus ===
+-        "edited" &&
+-      capability
+-        .editedEvidence
+-        ? capability
+-            .editedEvidence
+-        : capability
+-            .evidence;
+-
+-    if (
+-      capability
+-        .capabilityStatus ===
+-        "demonstrated" &&
+-      (
+-        capability
+-          .reviewStatus ===
+-          "accepted" ||
+-        capability
+-          .reviewStatus ===
+-          "edited"
+-      )
+-    ) {
+-      const competencyId =
+-        competencyMappings.get(
+-          capability.id
+-        ) ||
+-        capability
+-          .competencyId ||
+-        null;
+-
+-      await sql`
+-        INSERT INTO candidate_profile_role_capabilities (
+-          candidate_profile_role_id,
+-          competency_id,
+-          capability_name,
+-          confidence,
+-          evidence,
+-          source_type,
+-          updated_at
+-        )
+-        VALUES (
+-          ${profileRoleId},
+-          ${competencyId},
+-          ${name},
+-          ${capability.confidence || 0},
+-          ${evidence || null},
+-          ${capability.source || 'manual'},
+-          NOW()
+-        )
+-      `;
+-
+-      if (
+-        originalCanonicalRoleId &&
+-        competencyId
+-      ) {
+-        await sql`
+-          INSERT INTO candidate_knowledge (
+-            user_id,
+-            role_id,
+-            competency_id,
+-            confidence,
+-            updated_at
+-          )
+-          VALUES (
+-            ${userId},
+-            ${originalCanonicalRoleId},
+-            ${competencyId},
+-            ${capability.confidence || 0},
+-            NOW()
+-          )
+-          ON CONFLICT (
+-            user_id,
+-            role_id,
+-            competency_id
+-          )
+-          DO UPDATE SET
+-            confidence=
+-              EXCLUDED.confidence,
+-            updated_at=
+-              NOW()
+-        `;
+-      }
+-    }
+-
+-    if (
+-      capability
+-        .capabilityStatus ===
+-      "gap"
+-    ) {
+-      await sql`
+-        INSERT INTO candidate_profile_role_gaps (
+-          candidate_profile_role_id,
+-          competency_name,
+-          evidence
+-        )
+-        VALUES (
+-          ${profileRoleId},
+-          ${name},
+-          ${evidence || null}
+-        )
+-      `;
+-    }
+-  }
+-}
