-      VALUES (
-        ${answer.questionId},
-        ${roleAssessmentId},
-        ${answer.answer},
-        ${
-          evaluation
-            ?.status ||
-          'needs_clarification'
-        },
-        ${
-          evaluation
-            ?.evidence ||
-          null
-        },
-        ${
-          evaluation
-            ?.confidence ||
-          0
-        },
-        NOW()
-      )
-    `;
-
-    if (
-      !evaluation
-    ) {
-      continue;
-    }
-
-    const canonical =
-      await findCompetency(
-        evaluation.competency ||
-          answer.competency
