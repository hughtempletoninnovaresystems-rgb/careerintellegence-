-async function findCanonicalRole(
-  roleTitle: string
-) {
-  const exact =
-    await sql`
-      SELECT
-        id,
-        name,
-        job_title,
-        description,
-        lifecycle_status
-      FROM roles
-      WHERE
-        LOWER(name)=
-          LOWER(${roleTitle})
-        OR
-        LOWER(job_title)=
-          LOWER(${roleTitle})
-      LIMIT 1
-    `;
-
-  if (
-    exact.rows.length
-  ) {
-    return exact.rows[0];
-  }
-
-  return null;
-}
