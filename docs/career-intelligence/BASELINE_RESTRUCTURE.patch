+-/* ============================================================
+-   REPOSITORY ENRICHMENT
+-============================================================ */
+-
+-async function getOrCreateCanonicalCompetency(
+-  name: string
+-) {
+-  const existing =
+-    await findCompetency(
+-      name
+-    );
+-
+-  if (existing) {
+-    return {
+-      id:
+-        String(
+-          existing.id
+-        ),
+-      existing: true,
+-    };
+-  }
+-
+-  const result =
+-    await sql`
+-      INSERT INTO competencies (
+-        name,
+-        lifecycle_status
+-      )
+-      VALUES (
+-        ${name},
+-        'proposed'
+-      )
+-      ON CONFLICT (name)
+-      DO UPDATE SET
+-        name=
+-          EXCLUDED.name
+-      RETURNING id
+-    `;
+-
+-  return {
+-    id:
+-      String(
+-        result.rows[0].id
+-      ),
+-    existing: false,
+-  };
+-}
+-
+-async function getOrCreateCanonicalRole(
+-  title: string,
+-  description: string
+-) {
+-  const existing =
+-    await findCanonicalRole(
+-      title
+-    );
+-
+-  if (existing) {
+-    return {
+-      id:
+-        String(
+-          existing.id
+-        ),
+-      existing: true,
+-    };
+-  }
+-
+-  const result =
+-    await sql`
+-      INSERT INTO roles (
+-        name,
+-        job_title,
+-        description,
+-        lifecycle_status,
+-        updated_at
+-      )
+-      VALUES (
+-        ${title},
+-        ${title},
+-        ${description || null},
+-        'proposed',
+-        NOW()
+-      )
+-      ON CONFLICT (name)
+-      DO UPDATE SET
+-        updated_at=NOW()
+-      RETURNING id
+-    `;
+-
+-  return {
+-    id:
+-      String(
+-        result.rows[0].id
+-      ),
+-    existing: false,
+-  };
+-}
+-
+-async function getOrCreateRoleCompetency(
+-  roleId: string,
+-  competencyId: string
+-) {
+-  const existing =
+-    await sql`
+-      SELECT
+-        role_id,
+-        competency_id
+-      FROM role_competencies
+-      WHERE
+-        role_id=${roleId}
+-        AND
+-        competency_id=
+-          ${competencyId}
+-      LIMIT 1
+-    `;
+-
+-  if (
+-    existing.rows.length
+-  ) {
+-    return;
+-  }
+-
+-  await sql`
+-    INSERT INTO role_competencies (
+-      role_id,
+-      competency_id,
+-      importance,
+-      lifecycle_status
+-    )
+-    VALUES (
+-      ${roleId},
+-      ${competencyId},
+-      0.5,
+-      'proposed'
+-    )
+-  `;
+-}
+-
+-async function enrichCanonicalRepository(
+-  rolePayload: any
+-) {
+-  const canonicalRole =
+-    await getOrCreateCanonicalRole(
+-      rolePayload.roleTitle,
+-      rolePayload.roleDescription
+-    );
+-
+-  const acceptedCapabilities =
+-    rolePayload
+-      .stagedCapabilities
+-      .filter(
+-        (capability: any) =>
+-          capability
+-            .capabilityStatus ===
+-            "demonstrated" &&
+-          (
+-            capability
+-              .reviewStatus ===
+-              "accepted" ||
+-            capability
+-              .reviewStatus ===
+-              "edited"
+-          )
+-      );
+-
+-  const mappings: {
+-    capabilityId: string;
+-    competencyId: string;
+-  }[] = [];
+-
+-  for (
+-    const capability of
+-    acceptedCapabilities
+-  ) {
+-    const name =
+-      capability
+-        .editedCompetencyName ||
+-      capability
+-        .proposedCompetencyName;
+-
+-    const competency =
+-      await getOrCreateCanonicalCompetency(
+-        name
+-      );
+-
+-    await getOrCreateRoleCompetency(
+-      canonicalRole.id,
+-      competency.id
+-    );
+-
+-    mappings.push({
+-      capabilityId:
+-        String(
+-          capability.id
+-        ),
+-      competencyId:
+-        competency.id,
+-    });
+-  }
+-
+-  return {
+-    canonicalRoleId:
+-      canonicalRole.id,
+-    mappings,
+-  };
+-}
