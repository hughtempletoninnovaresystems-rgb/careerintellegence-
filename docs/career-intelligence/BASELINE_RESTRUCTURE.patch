+-
+-async function getRolePayload(
+-  roleAssessmentId: string
+-) {
+-  const roleResult =
+-    await sql`
+-      SELECT *
+-      FROM career_role_assessments
+-      WHERE id=
+-        ${roleAssessmentId}
+-      LIMIT 1
+-    `;
+-
+-  if (
+-    !roleResult.rows.length
+-  ) {
+-    throw new Error(
+-      "Role assessment not found."
+-    );
+-  }
+-
+-  const role =
+-    roleResult.rows[0];
+-
+-  const capabilityResult =
+-    await sql`
+-      SELECT
+-        crc.*,
+-        c.name AS canonical_name
+-      FROM career_role_capabilities crc
+-      LEFT JOIN competencies c
+-        ON c.id=
+-          crc.canonical_competency_id
+-      WHERE
+-        crc.role_assessment_id=
+-          ${roleAssessmentId}
+-      ORDER BY
+-        crc.created_at,
+-        crc.id
+-    `;
+-
+-  const questionResult =
+-    await sql`
+-      SELECT
+-        id,
+-        competency,
+-        reason,
+-        question,
+-        status,
+-        round_no,
+-        created_at,
+-        updated_at
+-      FROM career_role_questions
+-      WHERE
+-        role_assessment_id=
+-          ${roleAssessmentId}
+-        AND
+-        status='open'
+-      ORDER BY
+-        round_no,
+-        created_at,
+-        id
+-    `;
+-
+-  const assessmentId =
+-    String(
+-      role.assessment_id
+-    );
+-
+-  const successGates =
+-    await getSuccessGates(
+-      assessmentId,
+-      roleAssessmentId
+-    );
+-
+-  return {
+-    roleAssessmentId:
+-      String(role.id),
+-
+-    assessmentId,
+-
+-    sequenceNo:
+-      Number(
+-        role.sequence_no
+-      ),
+-
+-    canonicalRoleId:
+-      role.canonical_role_id
+-        ? String(
+-            role.canonical_role_id
+-          )
+-        : null,
+-
+-    organisationName:
+-      String(
+-        role.organisation_name ||
+-          ""
+-      ),
+-
+-    roleTitle:
+-      String(
+-        role.proposed_role_title ||
+-          ""
+-      ),
+-
+-    fromDate:
+-      formatDateForInput(
+-        role.from_date
+-      ),
+-
+-    toDate:
+-      role.to_date_precision ===
+-      "ongoing"
+-        ? ""
+-        : formatDateForInput(
+-            role.to_date
+-          ),
+-
+-    fromDatePrecision:
+-      role.from_date_precision
+-        ? String(
+-            role.from_date_precision
+-          )
+-        : null,
+-
+-    toDatePrecision:
+-      role.to_date_precision
+-        ? String(
+-            role.to_date_precision
+-          )
+-        : null,
+-
+-    fromDateOriginal:
+-      role.from_date_original
+-        ? String(
+-            role.from_date_original
+-          )
+-        : null,
+-
+-    toDateOriginal:
+-      role.to_date_original
+-        ? String(
+-            role.to_date_original
+-          )
+-        : null,
+-
+-    roleDescription:
+-      String(
+-        role.role_description ||
+-          ""
+-      ),
+-
+-    engagementModel:
+-      String(
+-        role.engagement_model ||
+-          ""
+-      ),
+-
+-    employmentContext:
+-      String(
+-        role.employment_context ||
+-          ""
+-      ),
+-
+-    lifecycleStatus:
+-      String(
+-        role.lifecycle_status ||
+-          ""
+-      ),
+-
+-    stagedCapabilities:
+-      capabilityResult.rows.map(
+-        (capability) => ({
+-          id:
+-            String(
+-              capability.id
+-            ),
+-
+-          canonicalCompetencyId:
+-            capability.canonical_competency_id
+-              ? String(
+-                  capability.canonical_competency_id
+-                )
+-              : null,
+-
+-          proposedCompetencyName:
+-            String(
+-              capability.edited_competency_name ||
+-                capability.canonical_name ||
+-                capability.proposed_competency_name ||
+-                ""
+-            ),
+-
+-          evidence:
+-            String(
+-              capability.edited_evidence ||
+-                capability.evidence ||
+-                ""
+-            ),
+-
+-          confidence:
+-            Number(
+-              capability.ai_confidence ||
+-                0
+-            ),
+-
+-          demonstrated:
+-            Boolean(
+-              capability.demonstrated
+-            ),
+-
+-          capabilityStatus:
+-            String(
+-              capability.capability_status
+-            ),
+-
+-          assessmentStatus:
+-            String(
+-              capability.assessment_status
+-            ),
+-
+-          reviewStatus:
+-            String(
+-              capability.review_status
+-            ),
+-
+-          editedCompetencyName:
+-            capability.edited_competency_name
+-              ? String(
+-                  capability.edited_competency_name
+-                )
+-              : null,
+-
+-          editedEvidence:
+-            capability.edited_evidence
+-              ? String(
+-                  capability.edited_evidence
+-                )
+-              : null,
+-
+-          sourceType:
+-            String(
+-              capability.source_type ||
+-                ""
+-            ),
+-        })
+-      ),
+-
+-    gaps:
+-      questionResult.rows.map(
+-        (question) => ({
+-          id:
+-            String(
+-              question.id
+-            ),
+-
+-          competency:
+-            String(
+-              question.competency ||
+-                ""
+-            ),
+-
+-          reason:
+-            String(
+-              question.reason ||
+-                ""
+-            ),
+-
+-          question:
+-            String(
+-              question.question ||
+-                ""
+-            ),
+-        })
+-      ),
+-
+-    successGates,
+-  };
+-}
