+-/* ============================================================
+-   REPOSITORY ENRICHMENT
+-============================================================ */
+-
+-async function getOrCreateCanonicalCompetency(
+-  name: string
+-) {
+-  const existing =
+-    await findCompetency(
+-      name
+-    );
+-
+-  if (existing) {
+-    return String(
+-      existing.id
+-    );
+-  }
+-
+-  const result =
+-    await sql`
+-      INSERT INTO competencies (
+-        name,
+-        lifecycle_status
+-      )
+-      VALUES (
+-        ${name},
+-        'proposed'
+-      )
+-      ON CONFLICT (name)
+-      DO UPDATE SET
+-        name=
+-          EXCLUDED.name
+-      RETURNING id
+-    `;
+-
+-  return String(
+-    result.rows[0].id
+-  );
+-}
+-
+-async function getOrCreateCanonicalRole(
+-  title: string,
+-  description: string
+-) {
+-  const existing =
+-    await findCanonicalRole(
+-      title
+-    );
+-
+-  if (existing) {
+-    return String(
+-      existing.id
+-    );
+-  }
+-
+-  const result =
+-    await sql`
+-      INSERT INTO roles (
+-        name,
+-        job_title,
+-        description,
+-        lifecycle_status,
+-        updated_at
+-      )
+-      VALUES (
+-        ${title},
+-        ${title},
+-        ${description || null},
+-        'proposed',
+-        NOW()
+-      )
+-      ON CONFLICT (name)
+-      DO UPDATE SET
+-        updated_at=
+-          NOW()
+-      RETURNING id
+-    `;
+-
+-  return String(
+-    result.rows[0].id
+-  );
+-}
+-
+-async function ensureRoleCompetency(
+-  roleId: string,
+-  competencyId: string
+-) {
+-  const existing =
+-    await sql`
+-      SELECT 1
+-      FROM role_competencies
+-      WHERE
+-        role_id=${roleId}
+-        AND
+-        competency_id=
+-          ${competencyId}
+-      LIMIT 1
+-    `;
+-
+-  if (
+-    existing.rows.length
+-  ) {
+-    return;
+-  }
+-
+-  await sql`
+-    INSERT INTO role_competencies (
+-      role_id,
+-      competency_id,
+-      importance,
+-      lifecycle_status
+-    )
+-    VALUES (
+-      ${roleId},
+-      ${competencyId},
+-      0.5,
+-      'proposed'
+-    )
+-  `;
+-}
