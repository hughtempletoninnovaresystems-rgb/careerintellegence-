+-async function replaceOpenQuestions(
+-  roleAssessmentId: string,
+-  gaps: Gap[]
+-) {
+-  if (
+-    !gaps.length
+-  ) {
+-    return;
+-  }
+-
+-  /*
+-   * Deliberately do not close existing open
+-   * questions here. Each enrichment round
+-   * is additive.
+-   */
+-  const roundResult =
+-    await sql`
+-      SELECT
+-        COALESCE(
+-          MAX(round_no),
+-          0
+-        ) AS max_round
+-      FROM career_role_questions
+-      WHERE role_assessment_id=
+-        ${roleAssessmentId}
+-    `;
+-
+-  const roundNo =
+-    Number(
+-      roundResult.rows[0]
+-        ?.max_round || 0
+-    ) + 1;
+-
+-  for (
+-    const gap of gaps
+-  ) {
+-    await sql`
+-      INSERT INTO career_role_questions (
+-        role_assessment_id,
+-        round_no,
+-        competency,
+-        reason,
+-        question,
+-        status,
+-        created_at,
+-        updated_at
+-      )
+-      VALUES (
+-        ${roleAssessmentId},
+-        ${roundNo},
+-        ${gap.competency},
+-        ${gap.reason},
+-        ${gap.question},
+-        'open',
+-        NOW(),
+-        NOW()
+-      )
+-    `;
+-  }
+-}
