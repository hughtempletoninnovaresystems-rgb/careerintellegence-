-      : [];
-
-  return {
-    emergingCapabilities:
-      emergingCapabilities
-        .filter(
-          (item: any) =>
-            typeof item
-              ?.name ===
-              "string" &&
-            item.name.trim()
-        )
-        .map(
-          (item: any) => ({
-            name:
-              item.name.trim(),
-
-            evidence:
-              typeof item
