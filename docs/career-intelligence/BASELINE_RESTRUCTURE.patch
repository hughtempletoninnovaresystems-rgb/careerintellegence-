+-/* ============================================================
+-   ROLE PAYLOAD
+-============================================================ */
+-
+-async function getRolePayload(
+-  roleAssessmentId: string
+-) {
+-  const roleResult =
+-    await sql`
+-      SELECT *
+-      FROM career_role_assessments
+-      WHERE id=
+-        ${roleAssessmentId}
+-      LIMIT 1
+-    `;
+-
+-  if (
+-    !roleResult.rows.length
+-  ) {
+-    throw new Error(
+-      "Role assessment not found."
+-    );
+-  }
+-
+-  const role =
+-    roleResult.rows[0];
+-
+-  const capabilities =
+-    await sql`
+-      SELECT
+-        crc.*,
+-        c.name AS canonical_name
+-      FROM career_role_capabilities crc
+-      LEFT JOIN competencies c
+-        ON c.id=
+-          crc.canonical_competency_id
+-      WHERE
+-        crc.role_assessment_id=
+-          ${roleAssessmentId}
+-      ORDER BY
+-        crc.created_at,
+-        crc.id
+-    `;
+-
+-  const questions =
+-    await sql`
+-      SELECT
+-        q.id,
+-        q.competency,
+-        q.reason,
+-        q.question,
+-        q.status,
+-        q.round_no,
+-
+-        (
+-          SELECT
+-            a.answer
+-          FROM career_role_answers a
+-          WHERE
+-            a.question_id=
+-              q.id
+-          ORDER BY
+-            a.created_at DESC
+-          LIMIT 1
+-        ) AS answer,
+-
+-        CASE
+-          WHEN q.status='answered'
+-          THEN q.updated_at
+-          ELSE NULL
+-        END AS answered_at
+-
+-      FROM career_role_questions q
+-
+-      WHERE
+-        q.role_assessment_id=
+-          ${roleAssessmentId}
+-
+-      ORDER BY
+-        q.round_no,
+-        q.created_at,
+-        q.id
+-    `;
+-
+-  const assessmentId =
+-    String(
+-      role.assessment_id
+-    );
+-
+-  const successGates =
+-    await getSuccessGates(
+-      assessmentId,
+-      roleAssessmentId
+-    );
+-
+-  return {
+-    id:
+-      String(
+-        role.id
+-      ),
+-
+-    assessmentId,
+-
+-    roleIndex:
+-      Number(
+-        role.sequence_no
+-      ),
+-
+-    canonicalRoleId:
+-      role.canonical_role_id
+-        ? String(
+-            role.canonical_role_id
+-          )
+-        : null,
+-
+-    organisation:
+-      String(
+-        role.organisation_name ||
+-          ""
+-      ),
+-
+-    roleTitle:
+-      String(
+-        role.proposed_role_title ||
+-          ""
+-      ),
+-
+-    fromDate:
+-      formatDateForInput(
+-        role.from_date
+-      ),
+-
+-    toDate:
+-      role.to_date_precision ===
+-      "ongoing"
+-        ? ""
+-        : formatDateForInput(
+-            role.to_date
+-          ),
+-
+-    fromDatePrecision:
+-      role.from_date_precision
+-        ? String(
+-            role.from_date_precision
+-          )
+-        : null,
+-
+-    toDatePrecision:
+-      role.to_date_precision
+-        ? String(
+-            role.to_date_precision
+-          )
+-        : null,
+-
+-    fromDateOriginal:
+-      role.from_date_original
+-        ? String(
+-            role.from_date_original
+-          )
+-        : null,
+-
+-    toDateOriginal:
+-      role.to_date_original
+-        ? String(
+-            role.to_date_original
+-          )
+-        : null,
+-
+-    description:
+-      String(
+-        role.role_description ||
+-          ""
+-      ),
+-
+-    engagementType:
+-      String(
+-        role.engagement_model ||
+-          ""
+-      ),
+-
+-    employmentType:
+-      String(
+-        role.employment_context ||
+-          ""
+-      ),
+-
+-    lifecycleStatus:
+-      String(
+-        role.lifecycle_status ||
+-          ""
+-      ),
+-
+-    capabilities:
+-      capabilities.rows.map(
+-        (capability) => ({
+-          id:
+-            String(
+-              capability.id
+-            ),
+-
+-          competencyId:
+-            capability.canonical_competency_id
+-              ? String(
+-                  capability.canonical_competency_id
+-                )
+-              : null,
+-
+-          name:
+-            String(
+-              capability.canonical_name ||
+-                capability.proposed_competency_name ||
+-                ""
+-            ),
+-
+-          evidence:
+-            String(
+-              capability.evidence ||
+-                ""
+-            ),
+-
+-          confidence:
+-            Number(
+-              capability.ai_confidence ||
+-                0
+-            ),
+-
+-          capabilityStatus:
+-            String(
+-              capability.capability_status
+-            ),
+-
+-          assessmentStatus:
+-            String(
+-              capability.assessment_status
+-            ),
+-
+-          reviewStatus:
+-            String(
+-              capability.review_status
+-            ),
+-
+-          editedName:
+-            capability.edited_competency_name
+-              ? String(
+-                  capability.edited_competency_name
+-                )
+-              : null,
+-
+-          editedEvidence:
+-            capability.edited_evidence
+-              ? String(
+-                  capability.edited_evidence
+-                )
+-              : null,
+-
+-          source:
+-            String(
+-              capability.source_type ||
+-                ""
+-            ),
+-        })
+-      ),
+-
+-    questions:
+-      questions.rows.map(
+-        (question) => ({
+-          id:
+-            String(
+-              question.id
+-            ),
+-
+-          capability:
+-            String(
+-              question.competency ||
+-                ""
+-            ),
+-
+-          question:
+-            String(
+-              question.question ||
+-                ""
+-            ),
+-
+-          reason:
+-            String(
+-              question.reason ||
+-                ""
+-            ),
+-
+-          answer:
+-            question.answer
+-              ? String(
+-                  question.answer
+-                )
+-              : null,
+-
+-          answeredAt:
+-            question.answered_at
+-              ? new Date(
+-                  question.answered_at
+-                ).toISOString()
+-              : null,
+-        })
+-      ),
+-
+-    successGates,
+-  };
+-}
