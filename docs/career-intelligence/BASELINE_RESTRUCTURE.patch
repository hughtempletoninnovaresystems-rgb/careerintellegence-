+-/* ============================================================
+-   CANONICAL REPOSITORY LOOKUPS
+-============================================================ */
+-
+-async function findCanonicalRole(
+-  roleTitle: string
+-) {
+-  const exact =
+-    await sql`
+-      SELECT
+-        id,
+-        name,
+-        job_title,
+-        description,
+-        lifecycle_status
+-      FROM roles
+-      WHERE
+-        LOWER(name)=
+-          LOWER(${roleTitle})
+-        OR
+-        LOWER(job_title)=
+-          LOWER(${roleTitle})
+-      LIMIT 1
+-    `;
+-
+-  if (
+-    exact.rows.length
+-  ) {
+-    return exact.rows[0];
+-  }
+-
+-  return null;
+-}
+-
+-async function findCompetency(
+-  name: string
+-) {
+-  const result =
+-    await sql`
+-      SELECT
+-        id,
+-        name,
+-        lifecycle_status
+-      FROM competencies
+-      WHERE LOWER(name)=
+-        LOWER(${name})
+-      LIMIT 1
+-    `;
+-
+-  return (
+-    result.rows[0] ||
+-    null
+-  );
+-}
+-
+-async function getRoleCompetencies(
+-  roleId: string
+-) {
+-  const result =
+-    await sql`
+-      SELECT
+-        c.id,
+-        c.name,
+-        rc.importance
+-      FROM role_competencies rc
+-      INNER JOIN competencies c
+-        ON c.id=
+-          rc.competency_id
+-      WHERE rc.role_id=
+-        ${roleId}
+-        AND
+-        COALESCE(
+-          rc.lifecycle_status,
+-          'approved'
+-        ) <> 'rejected'
+-      ORDER BY
+-        rc.importance DESC NULLS LAST,
+-        c.name
+-    `;
+-
+-  return result.rows;
+-}
+-
+-function nameMatches(
+-  left: string,
+-  right: string
+-) {
+-  return (
+-    left
+-      .trim()
+-      .toLowerCase() ===
+-    right
+-      .trim()
+-      .toLowerCase()
+-  );
+-}
+-
+-/* ============================================================
+-   AI — GAP QUESTIONS
+-============================================================ */
+-
+-async function generateQuestionsForExistingRole(
+-  role: ExtractedRole,
+-  canonicalRoleId: string
+-): Promise<Gap[]> {
+-  const expected =
+-    await getRoleCompetencies(
+-      canonicalRoleId
+-    );
+-
+-  const gaps =
+-    expected.filter(
+-      (competency) =>
+-        !role.capabilities.some(
+-          (capability) =>
+-            nameMatches(
+-              capability.name,
+-              String(
+-                competency.name
+-              )
+-            )
+-        )
+-    );
+-
+-  if (
+-    !gaps.length
+-  ) {
+-    return [];
+-  }
+-
+-  return gaps.map(
+-    (competency) => ({
+-      competency:
+-        String(
+-          competency.name
+-        ),
+-
+-      reason:
+-        "This capability is associated with the matched role but sufficient supporting evidence was not identified in the CV.",
+-
+-      question:
+-        `Can you describe a specific example from this role where you demonstrated ${String(
+-          competency.name
+-        )}? Include what you did and the outcome where possible.`,
+-    })
+-  );
+-}
+-
+-async function generateQuestionsForNewRole(
+-  role: ExtractedRole
+-): Promise<Gap[]> {
+-  const prompt = `
+-You are assessing a career role that does not currently match a canonical role in the repository.
+-
+-Determine whether there are likely role-relevant capability signals that require supporting evidence.
+-
+-Return JSON only:
+-
+-{
+-  "gaps": [
+-    {
+-      "competency": "",
+-      "reason": "",
+-      "question": ""
+-    }
+-  ]
+-}
+-
+-Rules:
+-
+-- Only ask where the role description provides a reasonable capability signal.
+-- Do not ask generic questions unrelated to the supplied role.
+-- A capability label alone is not enough evidence.
+-- Questions should ask for specific behavioural or outcome evidence.
+-- Do not duplicate capabilities already supported by evidence.
+-
+-Role title:
+-${role.roleTitle}
+-
+-Organisation:
+-${role.organisationName}
+-
+-Description:
+-${role.roleDescription}
+-
+-Already evidenced capabilities:
+-${JSON.stringify(
+-  role.capabilities
+-)}
+-`;
+-
+-  const response =
+-    await ai.models.generateContent(
+-      {
+-        model: MODEL,
+-        contents: prompt,
+-      }
+-    );
+-
+-  const parsed =
+-    JSON.parse(
+-      cleanJson(
+-        geminiText(
+-          response
+-        )
+-      )
+-    );
+-
+-  const gaps =
+-    Array.isArray(
+-      parsed?.gaps
+-    )
+-      ? parsed.gaps
+-      : [];
+-
+-  return gaps
+-    .filter(
+-      (gap: any) =>
+-        typeof gap
+-          ?.competency ===
+-          "string" &&
+-        gap.competency.trim() &&
+-        typeof gap
+-          ?.question ===
+-          "string" &&
+-        gap.question.trim()
+-    )
+-    .map(
+-      (gap: any) => ({
+-        competency:
+-          gap.competency.trim(),
+-
+-        reason:
+-          typeof gap.reason ===
+-          "string"
+-            ? gap.reason.trim()
+-            : "Additional evidence is required.",
+-
+-        question:
+-          gap.question.trim(),
+-      })
+-    );
+-}
