+-/* ============================================================
+-   START MANUAL
+-============================================================ */
+-
+-async function handleStartManual(
+-  body: any,
+-  userId: string
+-) {
+-  const roles =
+-    Array.isArray(
+-      body.roles
+-    )
+-      ? body.roles
+-      : [];
+-
+-  if (
+-    !roles.length
+-  ) {
+-    return NextResponse.json(
+-      {
+-        error:
+-          "At least one role is required.",
+-      },
+-      {
+-        status: 400,
+-      }
+-    );
+-  }
+-
+-  for (
+-    const role of roles
+-  ) {
+-    if (
+-      !String(
+-        role.organisation ||
+-          ""
+-      ).trim() ||
+-      !String(
+-        role.roleTitle ||
+-          ""
+-      ).trim() ||
+-      !String(
+-        role.description ||
+-          ""
+-      ).trim()
+-    ) {
+-      return NextResponse.json(
+-        {
+-          error:
+-            "Organisation, role title and role description are required for every role.",
+-        },
+-        {
+-          status: 400,
+-        }
+-      );
+-    }
+-  }
+-
+-  const assessmentId =
+-    await createAssessment(
+-      userId
+-    );
+-
+-  await recordSuccessGate({
+-    assessmentId,
+-    gateKey:
+-      "assessment_started",
+-    metadata: {
+-      sourceType:
+-        "manual",
+-    },
+-  });
+-
+-  await recordSuccessGate({
+-    assessmentId,
+-    gateKey:
+-      "roles_entered",
+-    metadata: {
+-      count:
+-        roles.length,
+-    },
+-  });
+-
+-  const createdRoles: any[] =
+-    [];
+-
+-  for (
+-    let index = 0;
+-    index < roles.length;
+-    index++
+-  ) {
+-    const input =
+-      roles[index];
+-
+-    const role:
+-      ManualRoleInput = {
+-      organisation:
+-        String(
+-          input.organisation ||
+-            ""
+-        ).trim(),
+-
+-      roleTitle:
+-        String(
+-          input.roleTitle ||
+-            ""
+-        ).trim(),
+-
+-      fromDate:
+-        input.fromDate ||
+-        null,
+-
+-      toDate:
+-        input.toDatePrecision ===
+-        "ongoing"
+-          ? null
+-          : input.toDate ||
+-            null,
+-
+-      fromDatePrecision:
+-        input.fromDatePrecision ||
+-        (
+-          input.fromDate
+-            ? "day"
+-            : "unknown"
+-        ),
+-
+-      toDatePrecision:
+-        input.toDatePrecision ===
+-        "ongoing"
+-          ? "ongoing"
+-          : input.toDatePrecision ||
+-            (
+-              input.toDate
+-                ? "day"
+-                : "unknown"
+-            ),
+-
+-      fromDateOriginal:
+-        input.fromDateOriginal ||
+-        input.fromDate ||
+-        null,
+-
+-      toDateOriginal:
+-        input.toDatePrecision ===
+-        "ongoing"
+-          ? "Present"
+-          : input.toDateOriginal ||
+-            input.toDate ||
+-            null,
+-
+-      description:
+-        String(
+-          input.description ||
+-            ""
+-        ).trim(),
+-
+-      engagementType:
+-        input.engagementType ||
+-        null,
+-
+-      employmentType:
+-        input.employmentType ||
+-        null,
+-    };
+-
+-    const canonical =
+-      await findCanonicalRole(
+-        role.roleTitle
+-      );
+-
+-    const roleAssessmentId =
+-      await createRoleAssessment(
+-        assessmentId,
+-        index + 1,
+-        role,
+-        canonical
+-          ? String(
+-              canonical.id
+-            )
+-          : null,
+-        index === 0
+-          ? "in_progress"
+-          : "not_started"
+-      );
+-
+-    await recordSuccessGate({
+-      assessmentId,
+-      roleAssessmentId,
+-      gateKey:
+-        "role_created",
+-      metadata: {
+-        sequenceNo:
+-          index + 1,
+-      },
+-    });
+-
+-    const analysis =
+-      await analyseManualRole(
+-        role,
+-        canonical
+-          ? String(
+-              canonical.id
+-            )
+-          : null
+-      );
+-
+-    for (
+-      const capability of
+-      analysis.capabilities
+-    ) {
+-      const canonicalCompetency =
+-        await findCompetency(
+-          capability.name
+-        );
+-
+-      await stageCapability(
+-        {
+-          roleAssessmentId,
+-
+-          competencyId:
+-            canonicalCompetency
+-              ? String(
+-                  canonicalCompetency.id
+-                )
+-              : null,
+-
+-          name:
+-            canonicalCompetency
+-              ? String(
+-                  canonicalCompetency.name
+-                )
+-              : capability.name,
+-
+-          sourceType:
+-            "manual_role",
+-
+-          evidence:
+-            capability.evidence,
+-
+-          confidence:
+-            capability.confidence,
+-
+-          demonstrated:
+-            true,
+-
+-          capabilityStatus:
+-            "demonstrated",
+-
+-          assessmentStatus:
+-            "assessed",
+-        }
+-      );
+-    }
+-
+-    await replaceOpenQuestions(
+-      roleAssessmentId,
+-      analysis.gaps
+-    );
+-
+-    if (
+-      index === 0 &&
+-      !analysis.gaps.length
+-    ) {
+-      await sql`
+-        UPDATE career_role_assessments
+-        SET
+-          lifecycle_status=
+-            'review_ready',
+-          updated_at=NOW()
+-        WHERE id=
+-          ${roleAssessmentId}
+-      `;
+-
+-      await recordSuccessGate({
+-        assessmentId,
+-        roleAssessmentId,
+-        gateKey:
+-          "clarification_completed",
+-      });
+-    }
+-
+-    await recordSuccessGate({
+-      assessmentId,
+-      roleAssessmentId,
+-      gateKey:
+-        "role_analysis_completed",
+-      metadata: {
+-        capabilities:
+-          analysis
+-            .capabilities
+-            .length,
+-
+-        questions:
+-          analysis
+-            .gaps
+-            .length,
+-      },
+-    });
+-
+-    createdRoles.push(
+-      await getRolePayload(
+-        roleAssessmentId
+-      )
+-    );
+-  }
+-
+-  const successGates =
+-    await getSuccessGates(
+-      assessmentId
+-    );
+-
+-  return NextResponse.json(
+-    {
+-      success: true,
+-      assessmentId,
+-      roles:
+-        createdRoles,
+-      successGates,
+-    }
+-  );
+-}
+-
+-/* ============================================================
+-   EVALUATE CLARIFICATION
+-============================================================ */
+-
+-async function evaluateAnswers(
+-  role: any,
+-  answers: any[]
+-): Promise<Evaluation[]> {
+-  const prompt = `
+-Evaluate candidate clarification evidence.
+-
+-Return JSON only:
+-
+-{
+-  "evaluations": [
+-    {
+-      "questionId": "",
+-      "competency": "",
+-      "status": "demonstrated | gap | needs_clarification",
+-      "evidence": "",
+-      "confidence": 0.0,
+-      "followUpQuestion": "",
+-      "followUpReason": "",
+-      "emergingCapabilities": [
+-        {
+-          "name": "",
+-          "evidence": "",
+-          "confidence": 0.0
+-        }
+-      ]
+-    }
+-  ]
+-}
+-
+-Rules:
+-
+-- Demonstrated requires evidence of what the candidate actually did.
+-- A capability keyword alone is insufficient.
+-- A new signal may reveal an additional capability.
+-- If the new signal lacks evidence, return a follow-up clarification.
+-- Do not invent evidence.
+-- Confidence must be 0 to 1.
+-
+-Role:
+-${JSON.stringify(
+-  role
+-)}
+-
+-Answers:
+-${JSON.stringify(
+-  answers
+-)}
+-`;
+-
+-  const response =
+-    await ai.models.generateContent(
+-      {
+-        model: MODEL,
+-        contents: prompt,
+-      }
+-    );
+-
+-  const parsed =
+-    JSON.parse(
+-      cleanJson(
+-        geminiText(
+-          response
+-        )
+-      )
+-    );
+-
+-  const evaluations =
+-    Array.isArray(
+-      parsed?.evaluations
+-    )
+-      ? parsed.evaluations
+-      : [];
+-
+-  return evaluations.map(
+-    (evaluation: any) => ({
+-      questionId:
+-        String(
+-          evaluation.questionId ||
+-            ""
+-        ),
+-
+-      competency:
+-        String(
+-          evaluation.competency ||
+-            ""
+-        ),
+-
+-      status:
+-        [
+-          "demonstrated",
+-          "gap",
+-          "needs_clarification",
+-        ].includes(
+-          evaluation.status
+-        )
+-          ? evaluation.status
+-          : "needs_clarification",
+-
+-      evidence:
+-        String(
+-          evaluation.evidence ||
+-            ""
+-        ),
+-
+-      confidence:
+-        clamp(
+-          Number(
+-            evaluation.confidence ||
+-              0
+-          )
+-        ),
+-
+-      followUpQuestion:
+-        evaluation.followUpQuestion ||
+-        undefined,
+-
+-      followUpReason:
+-        evaluation.followUpReason ||
+-        undefined,
+-
+-      emergingCapabilities:
+-        Array.isArray(
+-          evaluation
+-            .emergingCapabilities
+-        )
+-          ? evaluation
+-              .emergingCapabilities
+-              .map(
+-                (
+-                  item: any
+-                ) => ({
+-                  name:
+-                    String(
+-                      item.name ||
+-                        ""
+-                    ).trim(),
+-
+-                  evidence:
+-                    String(
+-                      item.evidence ||
+-                        ""
+-                    ).trim(),
+-
+-                  confidence:
+-                    clamp(
+-                      Number(
+-                        item.confidence ||
+-                          0
+-                      )
+-                    ),
+-                })
+-              )
+-              .filter(
+-                (
+-                  item: any
+-                ) =>
+-                  item.name
+-              )
+-          : [],
+-    })
+-  );
+-}
+-
+-async function handleAssessRole(
+-  body: any,
+-  userId: string
+-) {
+-  const roleAssessmentId =
+-    String(
+-      body.roleAssessmentId ||
+-        ""
+-    );
+-
+-  const assessmentId =
+-    await verifyRoleOwnership(
+-      roleAssessmentId,
+-      userId
+-    );
+-
+-  const answers =
+-    Array.isArray(
+-      body.answers
+-    )
+-      ? body.answers
+-      : [];
+-
+-  const submitted =
+-    answers.filter(
+-      (answer: any) =>
+-        answer
+-          ?.questionId &&
+-        typeof answer
+-          ?.answer ===
+-          "string" &&
+-        answer.answer.trim()
+-    );
+-
+-  if (
+-    !submitted.length
+-  ) {
+-    return NextResponse.json(
+-      {
+-        error:
+-          "At least one clarification answer is required.",
+-      },
+-      {
+-        status: 400,
+-      }
+-    );
+-  }
+-
+-  const role =
+-    await getRolePayload(
+-      roleAssessmentId
+-    );
+-
+-  const questionIds =
+-    submitted.map(
+-      (item: any) =>
+-        String(
+-          item.questionId
+-        )
+-    );
+-
+-  const questionResult =
+-    await sql`
+-      SELECT
+-        id,
+-        competency,
+-        reason,
+-        question
+-      FROM career_role_questions
+-      WHERE
+-        role_assessment_id=
+-          ${roleAssessmentId}
+-        AND
+-        status='open'
+-    `;
+-
+-  const fullAnswers =
+-    submitted.map(
+-      (answer: any) => {
+-        const question =
+-          questionResult.rows.find(
+-            (row) =>
+-              String(
+-                row.id
+-              ) ===
+-              String(
+-                answer.questionId
+-              )
+-          );
+-
+-        return {
+-          questionId:
+-            String(
+-              answer.questionId
+-            ),
+-
+-          competency:
+-            String(
+-              question
+-                ?.competency ||
+-                ""
+-            ),
+-
+-          question:
+-            String(
+-              question
+-                ?.question ||
+-                ""
+-            ),
+-
+-          answer:
+-            String(
+-              answer.answer
+-            ).trim(),
+-        };
+-      }
+-    );
+-
+-  const evaluations =
+-    await evaluateAnswers(
+-      role,
+-      fullAnswers
+-    );
+-
+-  const followUps:
+-    Gap[] = [];
+-
+-  for (
+-    const answer of
+-    fullAnswers
+-  ) {
+-    if (
+-      !questionIds.includes(
+-        answer.questionId
+-      )
+-    ) {
+-      continue;
+-    }
+-
+-    const evaluation =
+-      evaluations.find(
+-        (item) =>
+-          item.questionId ===
+-          answer.questionId
+-      );
+-
+-    await sql`
+-      UPDATE career_role_questions
+-      SET
+-        status='answered',
+-        updated_at=NOW()
+-      WHERE
+-        id=
+-          ${answer.questionId}
+-        AND
+-        role_assessment_id=
+-          ${roleAssessmentId}
+-    `;
+-
+-    await sql`
+-      INSERT INTO career_role_answers (
+-        question_id,
+-        role_assessment_id,
+-        answer,
+-        evaluation_status,
+-        evaluation_evidence,
+-        evaluation_confidence,
+-        created_at
+-      )
+-      VALUES (
+-        ${answer.questionId},
+-        ${roleAssessmentId},
+-        ${answer.answer},
+-        ${
+-          evaluation
+-            ?.status ||
+-          'needs_clarification'
+-        },
+-        ${
+-          evaluation
+-            ?.evidence ||
+-          null
+-        },
+-        ${
+-          evaluation
+-            ?.confidence ||
+-          0
+-        },
+-        NOW()
+-      )
+-    `;
+-
+-    if (
+-      !evaluation
+-    ) {
+-      continue;
+-    }
+-
+-    const canonical =
+-      await findCompetency(
+-        evaluation.competency ||
+-          answer.competency
+-      );
+-
+-    if (
+-      evaluation.status ===
+-      "demonstrated"
+-    ) {
+-      await stageCapability(
+-        {
+-          roleAssessmentId,
+-
+-          competencyId:
+-            canonical
+-              ? String(
+-                  canonical.id
+-                )
+-              : null,
+-
+-          name:
+-            canonical
+-              ? String(
+-                  canonical.name
+-                )
+-              : evaluation.competency,
+-
+-          sourceType:
+-            "clarification",
+-
+-          evidence:
+-            evaluation.evidence,
+-
+-          confidence:
+-            evaluation.confidence,
+-
+-          demonstrated:
+-            true,
+-
+-          capabilityStatus:
+-            "demonstrated",
+-
+-          assessmentStatus:
+-            "assessed",
+-        }
+-      );
+-    }
+-
+-    if (
+-      evaluation.status ===
+-      "gap"
+-    ) {
+-      await stageCapability(
+-        {
+-          roleAssessmentId,
+-
+-          competencyId:
+-            canonical
+-              ? String(
+-                  canonical.id
+-                )
+-              : null,
+-
+-          name:
+-            canonical
+-              ? String(
+-                  canonical.name
+-                )
+-              : evaluation.competency,
+-
+-          sourceType:
+-            "clarification",
+-
+-          evidence:
+-            evaluation.evidence,
+-
+-          confidence:
+-            evaluation.confidence,
+-
+-          demonstrated:
+-            false,
+-
+-          capabilityStatus:
+-            "gap",
+-
+-          assessmentStatus:
+-            "assessed",
+-        }
+-      );
+-    }
+-
+-    if (
+-      evaluation.status ===
+-        "needs_clarification" &&
+-      evaluation
+-        .followUpQuestion
+-    ) {
+-      followUps.push({
+-        competency:
+-          evaluation.competency,
+-
+-        reason:
+-          evaluation
+-            .followUpReason ||
+-          "Further evidence is required.",
+-
+-        question:
+-          evaluation
+-            .followUpQuestion,
+-      });
+-    }
+-
+-    for (
+-      const emerging of
+-      evaluation
+-        .emergingCapabilities ||
+-      []
+-    ) {
+-      const mapped =
+-        await findCompetency(
+-          emerging.name
+-        );
+-
+-      await stageCapability(
+-        {
+-          roleAssessmentId,
+-
+-          competencyId:
+-            mapped
+-              ? String(
+-                  mapped.id
+-                )
+-              : null,
+-
+-          name:
+-            mapped
+-              ? String(
+-                  mapped.name
+-                )
+-              : emerging.name,
+-
+-          sourceType:
+-            "clarification",
+-
+-          evidence:
+-            emerging.evidence,
+-
+-          confidence:
+-            emerging.confidence,
+-
+-          demonstrated:
+-            true,
+-
+-          capabilityStatus:
+-            "demonstrated",
+-
+-          assessmentStatus:
+-            "assessed",
+-        }
+-      );
+-    }
+-  }
+-
+-  await replaceOpenQuestions(
+-    roleAssessmentId,
+-    followUps
+-  );
+-
+-  await recordSuccessGate({
+-    assessmentId,
+-    roleAssessmentId,
+-    gateKey:
+-      "clarification_evaluation_completed",
+-  });
+-
+-  const remaining =
+-    await sql`
+-      SELECT COUNT(*)::int AS count
+-      FROM career_role_questions
+-      WHERE
+-        role_assessment_id=
+-          ${roleAssessmentId}
+-        AND
+-        status='open'
+-    `;
+-
+-  const openCount =
+-    Number(
+-      remaining.rows[0]
+-        ?.count || 0
+-    );
+-
+-  await sql`
+-    UPDATE career_role_assessments
+-    SET
+-      lifecycle_status=${
+-        openCount
+-          ? 'in_progress'
+-          : 'review_ready'
+-      },
+-      updated_at=NOW()
+-    WHERE id=
+-      ${roleAssessmentId}
+-  `;
+-
+-  if (
+-    !openCount
+-  ) {
+-    await recordSuccessGate({
+-      assessmentId,
+-      roleAssessmentId,
+-      gateKey:
+-        "clarification_completed",
+-    });
+-  }
+-
+-  const updatedRole =
+-    await getRolePayload(
+-      roleAssessmentId
+-    );
+-
+-  return NextResponse.json(
+-    {
+-      success: true,
+-      role:
+-        updatedRole,
+-      successGates:
+-        updatedRole
+-          .successGates,
+-    }
+-  );
+-}
