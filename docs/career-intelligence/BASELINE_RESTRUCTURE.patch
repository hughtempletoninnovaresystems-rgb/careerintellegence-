-async function findCompetency(
-  name: string
-) {
-  const result =
-    await sql`
-      SELECT
-        id,
-        name,
-        lifecycle_status
-      FROM competencies
-      WHERE LOWER(name)=
-        LOWER(${name})
-      LIMIT 1
