-  for (
-    const answer of
-    fullAnswers
-  ) {
-    if (
-      !questionIds.includes(
-        answer.questionId
-      )
-    ) {
-      continue;
-    }
-
-    const evaluation =
-      evaluations.find(
-        (item) =>
-          item.questionId ===
-          answer.questionId
-      );
-
-    await sql`
-      UPDATE career_role_questions
-      SET
-        status='answered',
-        updated_at=NOW()
