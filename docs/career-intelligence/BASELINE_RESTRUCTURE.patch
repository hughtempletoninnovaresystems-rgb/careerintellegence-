-      },
-    });
-
-    createdRoles.push(
-      await getRolePayload(
-        roleAssessmentId
-      )
-    );
-  }
-
-  const assessmentGates =
-    await getSuccessGates(
-      assessmentId
-    );
-
-  return NextResponse.json(
-    {
-      success: true,
-      assessmentId,
-      candidateName:
-        extracted.candidateName,
