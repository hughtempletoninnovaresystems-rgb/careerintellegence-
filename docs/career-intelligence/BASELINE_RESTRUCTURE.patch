+-/* ============================================================
+-   AI — CV EXTRACTION
+-============================================================ */
+-
+-async function extractCareerHistory(
+-  cvText: string
+-): Promise<{
+-  candidateName: string;
+-  roles: ExtractedRole[];
+-}> {
+-  const prompt = `
+-You are analysing a CV for Career Intelligence.
+-
+-Extract the candidate's career history.
+-
+-Return JSON only.
+-
+-Required structure:
+-
+-{
+-  "candidateName": "",
+-  "roles": [
+-    {
+-      "organisationName": "",
+-      "roleTitle": "",
+-
+-      "fromDate": "",
+-      "toDate": "",
+-
+-      "fromDateOriginal": "",
+-      "toDateOriginal": "",
+-
+-      "roleDescription": "",
+-      "engagementModel": "",
+-      "employmentContext": "",
+-
+-      "capabilities": [
+-        {
+-          "name": "",
+-          "evidence": "",
+-          "confidence": 0.0
+-        }
+-      ]
+-    }
+-  ]
+-}
+-
+-DATE RULES:
+-
+-- Keep the exact source wording in fromDateOriginal and toDateOriginal.
+-- Return fromDate and toDate in YYYY-MM-DD format where an exact date is known.
+-- If only a month and year are supplied, use the first day of that month.
+-- Example: "March 2020" becomes "2020-03-01".
+-- If only a year is supplied, use January 1.
+-- Example: "2018" becomes "2018-01-01".
+-- If a role is current, present or ongoing:
+-    toDate must be ""
+-    toDateOriginal should preserve the CV wording such as "Present".
+-- Never invent a different month or year.
+-- Use "" where a date cannot reasonably be determined.
+-
+-CAPABILITY RULES:
+-
+-- A capability must be supported by actual career evidence.
+-- Do not treat a capability keyword by itself as sufficient evidence.
+-- Evidence should describe what the candidate actually did.
+-- Keep capability names concise.
+-- Confidence must be between 0 and 1.
+-- Do not invent experience not present in the CV.
+-
+-CV:
+-
+-${cvText}
+-`;
+-
+-  const response =
+-    await ai.models.generateContent(
+-      {
+-        model: MODEL,
+-        contents: prompt,
+-      }
+-    );
+-
+-  const parsed =
+-    JSON.parse(
+-      cleanJson(
+-        geminiText(
+-          response
+-        )
+-      )
+-    );
+-
+-  const roles =
+-    Array.isArray(
+-      parsed?.roles
+-    )
+-      ? parsed.roles
+-      : [];
+-
+-  const normalisedRoles:
+-    ExtractedRole[] =
+-    roles
+-      .filter(
+-        (role: any) =>
+-          typeof role
+-            ?.roleTitle ===
+-            "string" &&
+-          role.roleTitle.trim()
+-      )
+-      .map(
+-        (role: any) => {
+-          const from =
+-            normaliseCVDate(
+-              role.fromDateOriginal ||
+-                role.fromDate,
+-              false
+-            );
+-
+-          const to =
+-            normaliseCVDate(
+-              role.toDateOriginal ||
+-                role.toDate,
+-              true
+-            );
+-
+-          const capabilities =
+-            Array.isArray(
+-              role.capabilities
+-            )
+-              ? role.capabilities
+-              : [];
+-
+-          return {
+-            organisationName:
+-              typeof role
+-                .organisationName ===
+-              "string"
+-                ? role.organisationName.trim()
+-                : "",
+-
+-            roleTitle:
+-              role.roleTitle.trim(),
+-
+-            fromDate:
+-              from.date,
+-
+-            toDate:
+-              to.date,
+-
+-            fromDatePrecision:
+-              from.precision,
+-
+-            toDatePrecision:
+-              to.precision,
+-
+-            fromDateOriginal:
+-              from.original,
+-
+-            toDateOriginal:
+-              to.original,
+-
+-            roleDescription:
+-              typeof role
+-                .roleDescription ===
+-              "string"
+-                ? role.roleDescription.trim()
+-                : "",
+-
+-            engagementModel:
+-              typeof role
+-                .engagementModel ===
+-              "string"
+-                ? role.engagementModel.trim()
+-                : "",
+-
+-            employmentContext:
+-              typeof role
+-                .employmentContext ===
+-              "string"
+-                ? role.employmentContext.trim()
+-                : "",
+-
+-            capabilities:
+-              capabilities
+-                .filter(
+-                  (capability: any) =>
+-                    typeof capability
+-                      ?.name ===
+-                      "string" &&
+-                    capability.name.trim()
+-                )
+-                .map(
+-                  (
+-                    capability: any
+-                  ) => ({
+-                    name:
+-                      capability.name.trim(),
+-
+-                    evidence:
+-                      typeof capability
+-                        .evidence ===
+-                      "string"
+-                        ? capability.evidence.trim()
+-                        : "",
+-
+-                    confidence:
+-                      clamp(
+-                        Number(
+-                          capability.confidence ??
+-                            0
+-                        )
+-                      ),
+-                  })
+-                ),
+-          };
+-        }
+-      );
+-
+-  return {
+-    candidateName:
+-      typeof parsed
+-        ?.candidateName ===
+-      "string"
+-        ? parsed.candidateName.trim()
+-        : "",
+-
+-    roles:
+-      normalisedRoles,
+-  };
+-}
