+/* ============================================================
+   CV UPLOAD
+============================================================ */
+
+async function handleCVUpload(
+  request: Request,
+  userId: string
+) {
+  const formData =
+    await request.formData();
+
+  const file =
+    formData.get("cv");
+
+  if (
+    !(file instanceof File)
+  ) {
+    return NextResponse.json(
+      {
+        error:
+          "A CV file is required.",
+      },
+      {
+        status: 400,
+      }
+    );
+  }
+
+  const lowerName =
+    file.name.toLowerCase();
+
+  if (
+    file.size >
+    careerIntelligenceConfig.maxCvFileBytes
+  ) {
+    return NextResponse.json(
+      {
+        error:
+          "The CV file exceeds the permitted size limit.",
+      },
+      {
+        status: 413,
+      }
+    );
+  }
+
+  const allowedMimeTypes =
+    new Set([
+      "application/pdf",
+      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
+      "",
+    ]);
+
+  if (
+    !allowedMimeTypes.has(
+      file.type
+    )
+  ) {
+    return NextResponse.json(
+      {
+        error:
+          "Only PDF and DOCX files are supported.",
+      },
+      {
+        status: 400,
+      }
+    );
+  }
+
+  if (
+    !lowerName.endsWith(
+      ".pdf"
+    ) &&
+    !lowerName.endsWith(
+      ".docx"
+    )
+  ) {
+    return NextResponse.json(
+      {
+        error:
+          "Only PDF and DOCX files are supported.",
+      },
+      {
+        status: 400,
+      }
+    );
+  }
+
+  const buffer =
+    Buffer.from(
+      await file.arrayBuffer()
+    );
+
+  const cvText =
+    lowerName.endsWith(
+      ".pdf"
+    )
+      ? await extractPdfText(
+          buffer
+        )
+      : await extractDocxText(
+          buffer
+        );
+
+  if (
+    !cvText.trim()
+  ) {
+    return NextResponse.json(
+      {
+        error:
+          "No readable text was found in the CV.",
+      },
+      {
+        status: 400,
+      }
+    );
+  }
+
+  if (
+    cvText.length >
+    careerIntelligenceConfig.maxCvTextChars
+  ) {
+    return NextResponse.json(
+      {
+        error:
+          "The CV contains more text than can be processed safely.",
+      },
+      {
+        status: 413,
+      }
+    );
+  }
+
+  const extracted =
+    await extractCareerHistory(
+      cvText
+    );
+
+  if (
+    !extracted.roles.length
+  ) {
+    return NextResponse.json(
+      {
+        error:
+          "No career roles could be identified from the CV.",
+      },
+      {
+        status: 400,
+      }
+    );
+  }
+
+  const assessmentId =
+    await createAssessment(
+      userId,
+      extracted.candidateName
+    );
+
+  await recordSuccessGate({
+    assessmentId,
+    gateKey:
+      "assessment_started",
+    metadata: {
+      sourceType: "cv",
+    },
+  });
+
+  await recordSuccessGate({
+    assessmentId,
+    gateKey:
+      "cv_uploaded",
+    metadata: {
+      filename:
+        file.name,
+    },
+  });
+
+  await recordSuccessGate({
+    assessmentId,
+    gateKey:
+      "cv_text_extracted",
+  });
+
+  await recordSuccessGate({
+    assessmentId,
+    gateKey:
+      "roles_identified",
+    metadata: {
+      count:
+        extracted.roles.length,
+    },
+  });
+
+  const createdRoles: any[] =
+    [];
+
+  for (
+    let index = 0;
+    index <
+    extracted.roles.length;
+    index++
+  ) {
+    const extractedRole =
+      extracted.roles[index];
+
+    const canonicalRole =
+      await findCanonicalRole(
+        extractedRole.roleTitle
+      );
+
+    const roleAssessmentId =
+      await createRoleAssessment(
+        assessmentId,
+        index + 1,
+        extractedRole,
+        canonicalRole
+          ? String(
+              canonicalRole.id
+            )
+          : null,
+        index === 0
+          ? "in_progress"
+          : "not_started"
+      );
+
+    await recordSuccessGate({
+      assessmentId,
+      roleAssessmentId,
+      gateKey:
+        "role_created",
+      metadata: {
+        sequenceNo:
+          index + 1,
+        matchedCanonicalRole:
+          Boolean(
+            canonicalRole
+          ),
+      },
+    });
+
+    for (
+      const capability of
+      extractedRole.capabilities
+    ) {
+      const mapped =
+        await mapCapability(
+          capability
+        );
+
+      await stageCapability(
+        {
+          roleAssessmentId,
+
+          competencyId:
+            mapped.competencyId,
+
+          name:
+            mapped.name,
+
+          sourceType:
+            "cv",
+
+          sourceSection:
+            extractedRole.roleTitle,
+
+          evidence:
+            capability.evidence,
+
+          confidence:
+            capability.confidence,
+
+          demonstrated:
+            true,
+
+          capabilityStatus:
+            "demonstrated",
+
+          assessmentStatus:
+            "assessed",
+        }
+      );
+    }
+
+    const gaps =
+      canonicalRole
+        ? await generateQuestionsForExistingRole(
+            extractedRole,
+            String(
+              canonicalRole.id
+            )
+          )
+        : await generateQuestionsForNewRole(
+            extractedRole
+          );
+
+    await replaceOpenQuestions(
+      roleAssessmentId,
+      gaps
+    );
+
+    /*
+     * First role can be review_ready immediately
+     * if no clarification is required.
+     */
+    if (
+      index === 0 &&
+      !gaps.length
+    ) {
+      await transitionRoleLifecycle({
+        roleAssessmentId,
+        to: "review_ready",
+      });
+
+      await recordSuccessGate(
+        {
+          assessmentId,
+          roleAssessmentId,
+          gateKey:
+            "clarification_completed",
+        }
+      );
+    }
+
+    await recordSuccessGate({
+      assessmentId,
+      roleAssessmentId,
+      gateKey:
+        "role_analysis_completed",
+      metadata: {
+        initialCapabilities:
+          extractedRole
+            .capabilities
+            .length,
+
+        clarificationQuestions:
+          gaps.length,
+      },
+    });
+
+    createdRoles.push(
+      await getRolePayload(
+        roleAssessmentId
+      )
+    );
+  }
+
+  const assessmentGates =
+    await getSuccessGates(
+      assessmentId
+    );
+
+  return NextResponse.json(
+    {
+      success: true,
+      assessmentId,
+      candidateName:
+        extracted.candidateName,
+      roles:
+        createdRoles,
+      successGates:
+        assessmentGates,
+    }
+  );
+}
+
+/* ============================================================
+   CLARIFICATION EVALUATION
+============================================================ */
+
+async function handleAssessRole(
+  body: any,
