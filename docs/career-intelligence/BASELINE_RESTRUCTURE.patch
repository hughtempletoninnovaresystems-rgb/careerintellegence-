+-/* ============================================================
+-   CLARIFICATION EVALUATION
+-============================================================ */
+-
+-async function evaluateAnswers(
+-  rolePayload: any,
+-  submittedQuestions: any[]
+-): Promise<Evaluation[]> {
+-  const prompt = `
+-You are assessing clarification evidence for a career role.
+-
+-Return JSON only.
+-
+-{
+-  "evaluations": [
+-    {
+-      "questionId": "",
+-      "competency": "",
+-      "status": "demonstrated | gap | needs_clarification",
+-      "evidence": "",
+-      "confidence": 0.0,
+-      "followUpQuestion": "",
+-      "followUpReason": "",
+-      "emergingCapabilities": [
+-        {
+-          "name": "",
+-          "evidence": "",
+-          "confidence": 0.0
+-        }
+-      ]
+-    }
+-  ]
+-}
+-
+-Rules:
+-
+-- "demonstrated" requires meaningful evidence of what the person actually did.
+-- A capability keyword alone is not sufficient evidence.
+-- "gap" means the response does not establish demonstration and further questioning is not reasonably useful.
+-- "needs_clarification" means there is a plausible signal but more evidence could establish it.
+-- When a response evidences an additional capability, return it under emergingCapabilities.
+-- Do not invent evidence.
+-- Confidence must be 0 to 1.
+-
+-Role:
+-${JSON.stringify(
+-  {
+-    organisation:
+-      rolePayload.organisationName,
+-    roleTitle:
+-      rolePayload.roleTitle,
+-    description:
+-      rolePayload.roleDescription,
+-  }
+-)}
+-
+-Questions and answers:
+-${JSON.stringify(
+-  submittedQuestions
+-)}
+-`;
+-
+-  const response =
+-    await ai.models.generateContent(
+-      {
+-        model: MODEL,
+-        contents: prompt,
+-      }
+-    );
+-
+-  const parsed =
+-    JSON.parse(
+-      cleanJson(
+-        geminiText(
+-          response
+-        )
+-      )
+-    );
+-
+-  const evaluations =
+-    Array.isArray(
+-      parsed?.evaluations
+-    )
+-      ? parsed.evaluations
+-      : [];
+-
+-  return evaluations.map(
+-    (evaluation: any) => ({
+-      questionId:
+-        String(
+-          evaluation.questionId ||
+-            ""
+-        ),
+-
+-      competency:
+-        String(
+-          evaluation.competency ||
+-            ""
+-        ),
+-
+-      status:
+-        evaluation.status ===
+-          "demonstrated" ||
+-        evaluation.status ===
+-          "gap" ||
+-        evaluation.status ===
+-          "needs_clarification"
+-          ? evaluation.status
+-          : "needs_clarification",
+-
+-      evidence:
+-        typeof evaluation
+-          .evidence ===
+-        "string"
+-          ? evaluation.evidence.trim()
+-          : "",
+-
+-      confidence:
+-        clamp(
+-          Number(
+-            evaluation.confidence ||
+-              0
+-          )
+-        ),
+-
+-      followUpQuestion:
+-        typeof evaluation
+-          .followUpQuestion ===
+-        "string"
+-          ? evaluation.followUpQuestion.trim()
+-          : undefined,
+-
+-      followUpReason:
+-        typeof evaluation
+-          .followUpReason ===
+-        "string"
+-          ? evaluation.followUpReason.trim()
+-          : undefined,
+-
+-      emergingCapabilities:
+-        Array.isArray(
+-          evaluation
+-            .emergingCapabilities
+-        )
+-          ? evaluation.emergingCapabilities
+-              .filter(
+-                (
+-                  capability: any
+-                ) =>
+-                  typeof capability
+-                    ?.name ===
+-                    "string" &&
+-                  capability.name.trim()
+-              )
+-              .map(
+-                (
+-                  capability: any
+-                ) => ({
+-                  name:
+-                    capability.name.trim(),
+-
+-                  evidence:
+-                    typeof capability
+-                      .evidence ===
+-                    "string"
+-                      ? capability.evidence.trim()
+-                      : "",
+-
+-                  confidence:
+-                    clamp(
+-                      Number(
+-                        capability.confidence ||
+-                          0
+-                      )
+-                    ),
+-                })
+-              )
+-          : [],
+-    })
+-  );
+-}
+-
+-async function handleAssessRole(
+-  body: any,
+-  userId: string
+-) {
+-  const roleAssessmentId =
+-    String(
+-      body.roleAssessmentId ||
+-        ""
+-    );
+-
+-  if (
+-    !roleAssessmentId
+-  ) {
+-    return NextResponse.json(
+-      {
+-        error:
+-          "roleAssessmentId is required.",
+-      },
+-      {
+-        status: 400,
+-      }
+-    );
+-  }
+-
+-  const assessmentId =
+-    await verifyRoleOwnership(
+-      roleAssessmentId,
+-      userId
+-    );
+-
+-  /*
+-   * CV route accepts:
+-   *
+-   * questions: [
+-   *   {
+-   *     gapId,
+-   *     competency,
+-   *     question,
+-   *     answer
+-   *   }
+-   * ]
+-   */
+-  const questions =
+-    Array.isArray(
+-      body.questions
+-    )
+-      ? body.questions
+-      : [];
+-
+-  const submitted =
+-    questions.filter(
+-      (question: any) =>
+-        question?.gapId &&
+-        typeof question
+-          ?.answer ===
+-          "string" &&
+-        question.answer.trim()
+-    );
+-
+-  if (
+-    !submitted.length
+-  ) {
+-    return NextResponse.json(
+-      {
+-        error:
+-          "At least one clarification answer is required.",
+-      },
+-      {
+-        status: 400,
+-      }
+-    );
+-  }
+-
+-  const rolePayload =
+-    await getRolePayload(
+-      roleAssessmentId
+-    );
+-
+-  const evaluations =
+-    await evaluateAnswers(
+-      rolePayload,
+-      submitted
+-    );
+-
+-  const followUps: Gap[] =
+-    [];
+-
+-  for (
+-    const submittedQuestion
+-    of submitted
+-  ) {
+-    const questionId =
+-      String(
+-        submittedQuestion.gapId
+-      );
+-
+-    const evaluation =
+-      evaluations.find(
+-        (item) =>
+-          item.questionId ===
+-          questionId
+-      );
+-
+-    await sql`
+-      UPDATE career_role_questions
+-      SET
+-        status='answered',
+-        updated_at=NOW()
+-      WHERE
+-        id=${questionId}
+-        AND
+-        role_assessment_id=
+-          ${roleAssessmentId}
+-    `;
+-
+-    await sql`
+-      INSERT INTO career_role_answers (
+-        question_id,
+-        role_assessment_id,
+-        answer,
+-        evaluation_status,
+-        evaluation_evidence,
+-        evaluation_confidence,
+-        created_at
+-      )
+-      VALUES (
+-        ${questionId},
+-        ${roleAssessmentId},
+-        ${String(
+-          submittedQuestion.answer
+-        ).trim()},
+-        ${
+-          evaluation
+-            ?.status ||
+-          'needs_clarification'
+-        },
+-        ${
+-          evaluation
+-            ?.evidence ||
+-          null
+-        },
+-        ${
+-          evaluation
+-            ?.confidence ||
+-          0
+-        },
+-        NOW()
+-      )
+-    `;
+-
+-    if (
+-      !evaluation
+-    ) {
+-      continue;
+-    }
+-
+-    const canonical =
+-      await findCompetency(
+-        evaluation.competency ||
+-          submittedQuestion
+-            .competency ||
+-          ""
+-      );
+-
+-    if (
+-      evaluation.status ===
+-      "demonstrated"
+-    ) {
+-      await stageCapability(
+-        {
+-          roleAssessmentId,
+-
+-          competencyId:
+-            canonical
+-              ? String(
+-                  canonical.id
+-                )
+-              : null,
+-
+-          name:
+-            canonical
+-              ? String(
+-                  canonical.name
+-                )
+-              : evaluation.competency,
+-
+-          sourceType:
+-            "clarification",
+-
+-          sourceSection:
+-            "candidate_answer",
+-
+-          evidence:
+-            evaluation.evidence,
+-
+-          confidence:
+-            evaluation.confidence,
+-
+-          demonstrated:
+-            true,
+-
+-          capabilityStatus:
+-            "demonstrated",
+-
+-          assessmentStatus:
+-            "assessed",
+-        }
+-      );
+-    }
+-
+-    if (
+-      evaluation.status ===
+-      "gap"
+-    ) {
+-      await stageCapability(
+-        {
+-          roleAssessmentId,
+-
+-          competencyId:
+-            canonical
+-              ? String(
+-                  canonical.id
+-                )
+-              : null,
+-
+-          name:
+-            canonical
+-              ? String(
+-                  canonical.name
+-                )
+-              : evaluation.competency,
+-
+-          sourceType:
+-            "clarification",
+-
+-          sourceSection:
+-            "candidate_answer",
+-
+-          evidence:
+-            evaluation.evidence,
+-
+-          confidence:
+-            evaluation.confidence,
+-
+-          demonstrated:
+-            false,
+-
+-          capabilityStatus:
+-            "gap",
+-
+-          assessmentStatus:
+-            "assessed",
+-        }
+-      );
+-    }
+-
+-    if (
+-      evaluation.status ===
+-        "needs_clarification" &&
+-      evaluation
+-        .followUpQuestion
+-    ) {
+-      followUps.push({
+-        competency:
+-          evaluation.competency,
+-
+-        reason:
+-          evaluation
+-            .followUpReason ||
+-          "Further evidence is required.",
+-
+-        question:
+-          evaluation
+-            .followUpQuestion,
+-      });
+-    }
+-
+-    for (
+-      const emerging of
+-      evaluation.emergingCapabilities ||
+-      []
+-    ) {
+-      const mapped =
+-        await mapCapability(
+-          emerging
+-        );
+-
+-      await stageCapability(
+-        {
+-          roleAssessmentId,
+-
+-          competencyId:
+-            mapped.competencyId,
+-
+-          name:
+-            mapped.name,
+-
+-          sourceType:
+-            "clarification",
+-
+-          sourceSection:
+-            "emerging_capability",
+-
+-          evidence:
+-            emerging.evidence,
+-
+-          confidence:
+-            emerging.confidence,
+-
+-          demonstrated:
+-            true,
+-
+-          capabilityStatus:
+-            "demonstrated",
+-
+-          assessmentStatus:
+-            "assessed",
+-        }
+-      );
+-    }
+-  }
+-
+-  await replaceOpenQuestions(
+-    roleAssessmentId,
+-    followUps
+-  );
+-
+-  await recordSuccessGate({
+-    assessmentId,
+-    roleAssessmentId,
+-    gateKey:
+-      "clarification_evaluation_completed",
+-  });
+-
+-  const remaining =
+-    await sql`
+-      SELECT COUNT(*)::int AS count
+-      FROM career_role_questions
+-      WHERE
+-        role_assessment_id=
+-          ${roleAssessmentId}
+-        AND
+-        status='open'
+-    `;
+-
+-  const openCount =
+-    Number(
+-      remaining.rows[0]
+-        ?.count || 0
+-    );
+-
+-  await sql`
+-    UPDATE career_role_assessments
+-    SET
+-      lifecycle_status=${
+-        openCount > 0
+-          ? 'in_progress'
+-          : 'review_ready'
+-      },
+-      updated_at=NOW()
+-    WHERE id=
+-      ${roleAssessmentId}
+-  `;
+-
+-  if (
+-    openCount === 0
+-  ) {
+-    await recordSuccessGate({
+-      assessmentId,
+-      roleAssessmentId,
+-      gateKey:
+-        "clarification_completed",
+-    });
+-  }
+-
+-  const role =
+-    await getRolePayload(
+-      roleAssessmentId
+-    );
+-
+-  return NextResponse.json(
+-    {
+-      success: true,
+-      role,
+-      successGates:
+-        role.successGates,
+-    }
+-  );
+-}
