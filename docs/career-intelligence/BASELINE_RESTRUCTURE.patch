-/* ============================================================
-   CLARIFICATION EVALUATION
-============================================================ */
-
-async function evaluateAnswers(
-  rolePayload: any,
-  submittedQuestions: any[]
-): Promise<Evaluation[]> {
-  const prompt = `
-You are assessing clarification evidence for a career role.
-
-Return JSON only.
-
-{
-  "evaluations": [
-    {
-      "questionId": "",
-      "competency": "",
-      "status": "demonstrated | gap | needs_clarification",
-      "evidence": "",
-      "confidence": 0.0,
-      "followUpQuestion": "",
-      "followUpReason": "",
-      "emergingCapabilities": [
-        {
-          "name": "",
-          "evidence": "",
-          "confidence": 0.0
-        }
-      ]
-    }
-  ]
-}
-
-Rules:
-
-- "demonstrated" requires meaningful evidence of what the person actually did.
-- A capability keyword alone is not sufficient evidence.
-- "gap" means the response does not establish demonstration and further questioning is not reasonably useful.
-- "needs_clarification" means there is a plausible signal but more evidence could establish it.
-- When a response evidences an additional capability, return it under emergingCapabilities.
-- Do not invent evidence.
-- Confidence must be 0 to 1.
-
-Role:
-${JSON.stringify(
-  {
-    organisation:
-      rolePayload.organisationName,
-    roleTitle:
-      rolePayload.roleTitle,
-    description:
-      rolePayload.roleDescription,
-  }
-)}
-
-Questions and answers:
-${JSON.stringify(
-  submittedQuestions
-)}
-`;
-
-  const response =
-    await ai.models.generateContent(
-      {
-        model: MODEL,
-        contents: prompt,
-      }
-    );
-
-  const parsed =
-    JSON.parse(
-      cleanJson(
-        geminiText(
-          response
-        )
-      )
-    );
-
-  const evaluations =
-    Array.isArray(
-      parsed?.evaluations
-    )
-      ? parsed.evaluations
-      : [];
-
-  return evaluations.map(
-    (evaluation: any) => ({
-      questionId:
-        String(
-          evaluation.questionId ||
-            ""
-        ),
-
-      competency:
-        String(
-          evaluation.competency ||
-            ""
-        ),
-
-      status:
-        evaluation.status ===
-          "demonstrated" ||
-        evaluation.status ===
-          "gap" ||
-        evaluation.status ===
-          "needs_clarification"
-          ? evaluation.status
-          : "needs_clarification",
-
-      evidence:
-        typeof evaluation
-          .evidence ===
-        "string"
-          ? evaluation.evidence.trim()
-          : "",
-
-      confidence:
-        clamp(
-          Number(
-            evaluation.confidence ||
-              0
-          )
-        ),
-
-      followUpQuestion:
-        typeof evaluation
-          .followUpQuestion ===
-        "string"
