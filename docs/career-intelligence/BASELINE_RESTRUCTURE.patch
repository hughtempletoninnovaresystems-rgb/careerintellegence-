-============================================================ */
-
-async function handleCVUpload(
-  request: Request,
-  userId: string
-) {
-  const formData =
-    await request.formData();
-
-  const file =
-    formData.get("cv");
-
-  if (
-    !(file instanceof File)
-  ) {
-    return NextResponse.json(
-      {
-        error:
-          "A CV file is required.",
-      },
-      {
-        status: 400,
-      }
-    );
-  }
-
-  const lowerName =
-    file.name.toLowerCase();
-
-  if (
-    !lowerName.endsWith(
-      ".pdf"
-    ) &&
-    !lowerName.endsWith(
-      ".docx"
-    )
-  ) {
-    return NextResponse.json(
-      {
-        error:
-          "Only PDF and DOCX files are supported.",
-      },
-      {
-        status: 400,
-      }
-    );
-  }
-
-  const buffer =
-    Buffer.from(
-      await file.arrayBuffer()
-    );
-
-  const cvText =
-    lowerName.endsWith(
-      ".pdf"
-    )
-      ? await extractPdfText(
-          buffer
-        )
-      : await extractDocxText(
-          buffer
-        );
-
-  if (
-    !cvText.trim()
-  ) {
-    return NextResponse.json(
-      {
-        error:
-          "No readable text was found in the CV.",
-      },
-      {
-        status: 400,
-      }
-    );
-  }
-
-  const extracted =
-    await extractCareerHistory(
-      cvText
-    );
-
-  if (
-    !extracted.roles.length
-  ) {
-    return NextResponse.json(
-      {
-        error:
-          "No career roles could be identified from the CV.",
-      },
-      {
-        status: 400,
-      }
-    );
-  }
-
-  const assessmentId =
-    await createAssessment(
-      userId,
-      extracted.candidateName
-    );
-
-  await recordSuccessGate({
-    assessmentId,
-    gateKey:
-      "assessment_started",
-    metadata: {
-      sourceType: "cv",
-    },
-  });
-
-  await recordSuccessGate({
-    assessmentId,
-    gateKey:
-      "cv_uploaded",
-    metadata: {
-      filename:
-        file.name,
-    },
-  });
-
-  await recordSuccessGate({
-    assessmentId,
-    gateKey:
-      "cv_text_extracted",
-  });
-
-  await recordSuccessGate({
-    assessmentId,
-    gateKey:
-      "roles_identified",
-    metadata: {
-      count:
-        extracted.roles.length,
-    },
-  });
-
-  const createdRoles: any[] =
-    [];
-
-  for (
-    let index = 0;
-    index <
-    extracted.roles.length;
-    index++
-  ) {
-    const extractedRole =
-      extracted.roles[index];
-
-    const canonicalRole =
-      await findCanonicalRole(
-        extractedRole.roleTitle
-      );
-
-    const roleAssessmentId =
-      await createRoleAssessment(
-        assessmentId,
-        index + 1,
-        extractedRole,
-        canonicalRole
-          ? String(
-              canonicalRole.id
-            )
-          : null,
-        index === 0
-          ? "in_progress"
-          : "not_started"
-      );
-
-    await recordSuccessGate({
-      assessmentId,
-      roleAssessmentId,
-      gateKey:
-        "role_created",
-      metadata: {
-        sequenceNo:
-          index + 1,
-        matchedCanonicalRole:
-          Boolean(
-            canonicalRole
-          ),
-      },
-    });
-
-    for (
-      const capability of
-      extractedRole.capabilities
-    ) {
-      const mapped =
-        await mapCapability(
-          capability
-        );
-
-      await stageCapability(
-        {
-          roleAssessmentId,
-
-          competencyId:
-            mapped.competencyId,
-
-          name:
-            mapped.name,
-
-          sourceType:
-            "cv",
-
-          sourceSection:
-            extractedRole.roleTitle,
-
-          evidence:
-            capability.evidence,
-
-          confidence:
-            capability.confidence,
-
-          demonstrated:
-            true,
-
-          capabilityStatus:
-            "demonstrated",
-
-          assessmentStatus:
-            "assessed",
-        }
-      );
-    }
-
-    const gaps =
-      canonicalRole
-        ? await generateQuestionsForExistingRole(
-            extractedRole,
-            String(
-              canonicalRole.id
-            )
-          )
-        : await generateQuestionsForNewRole(
-            extractedRole
-          );
-
-    await replaceOpenQuestions(
-      roleAssessmentId,
-      gaps
-    );
-
-    /*
-     * First role can be review_ready immediately
-     * if no clarification is required.
-     */
-    if (
-      index === 0 &&
-      !gaps.length
-    ) {
-      await sql`
-        UPDATE career_role_assessments
-        SET
-          lifecycle_status=
-            'review_ready',
-          updated_at=NOW()
-        WHERE id=
-          ${roleAssessmentId}
-      `;
-
-      await recordSuccessGate(
-        {
-          assessmentId,
-          roleAssessmentId,
-          gateKey:
-            "clarification_completed",
-        }
-      );
-    }
-
-    await recordSuccessGate({
-      assessmentId,
-      roleAssessmentId,
-      gateKey:
-        "role_analysis_completed",
-      metadata: {
-        initialCapabilities:
-          extractedRole
-            .capabilities
-            .length,
-
-        clarificationQuestions:
