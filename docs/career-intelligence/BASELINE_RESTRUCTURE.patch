+-      SELECT
+-        cra.assessment_id
+-      FROM career_role_assessments cra
+-      INNER JOIN career_assessments ca
+-        ON ca.id=
+-          cra.assessment_id
+-      WHERE
+-        cra.id=
+-          ${roleAssessmentId}
+-        AND
+-        ca.user_id=
