+/* ============================================================
+   MANUAL ROLE ANALYSIS
+============================================================ */
+
+async function analyseManualRole(
+  role: ManualRoleInput,
+  canonicalRoleId:
+    | string
+    | null
+): Promise<{
+  capabilities:
+    ExtractedCapability[];
+  gaps: Gap[];
+}> {
+  const expected =
+    canonicalRoleId
+      ? await getRoleCompetencies(
+          canonicalRoleId
+        )
+      : [];
+
+  const prompt = `
+You are assessing manually entered career experience.
+
+Identify demonstrated capabilities and areas requiring evidence enrichment.
+
+${CAPABILITY_IDENTITY_RULES}
+${EVIDENCE_ASSESSMENT_RULES}
+
+Return JSON only:
+
+{
+  "capabilities": [
+    {
+      "name": "",
+      "evidence": "",
+      "confidence": 0.0
+    }
+  ],
+  "gaps": [
+    {
+      "competency": "",
+      "reason": "",
+      "question": ""
+    }
+  ]
+}
+
+Rules:
+
+- A demonstrated capability requires evidence of what the candidate actually did.
+- A capability keyword or responsibility label by itself is not sufficient evidence.
+- Where there is a plausible capability signal but insufficient evidence, place it in gaps and ask a specific clarification question.
+- Questions should request what the candidate did, their responsibility and the result where possible.
+- Do not invent career experience.
+- Confidence must be between 0 and 1.
+
+Role:
+${JSON.stringify(
+  {
+    organisation:
+      role.organisation,
+    roleTitle:
+      role.roleTitle,
+    description:
+      role.description,
+    engagementType:
+      role.engagementType,
+    employmentType:
+      role.employmentType,
+  }
+)}
+
+Canonical expected competencies:
+${JSON.stringify(
+  expected.map(
+    (item) => ({
+      name:
+        item.name,
+      importance:
+        item.importance,
+    })
+  )
+)}
+`;
+
+  const parsed =
+    await generateValidatedJson({
+      prompt,
+      schema:
+        manualRoleAnalysisSchema,
+    });
+
+  const capabilities =
+    Array.isArray(
+      parsed?.capabilities
+    )
+      ? parsed.capabilities
+      : [];
+
+  const gaps =
+    Array.isArray(
+      parsed?.gaps
+    )
+      ? parsed.gaps
+      : [];
+
+  return {
+    capabilities:
+      capabilities
+        .filter(
+          (capability: any) =>
+            typeof capability
+              ?.name ===
+              "string" &&
+            capability.name.trim()
+        )
+        .map(
+          (
+            capability: any
+          ) => ({
+            name:
+              capability.name.trim(),
+
+            evidence:
+              typeof capability
+                .evidence ===
+              "string"
+                ? capability.evidence.trim()
+                : "",
+
+            confidence:
+              clamp(
+                Number(
+                  capability.confidence ||
+                    0
+                )
+              ),
+          })
+        ),
+
+    gaps:
+      gaps
+        .filter(
+          (gap: any) =>
+            typeof gap
+              ?.competency ===
+              "string" &&
+            gap.competency.trim() &&
+            typeof gap
+              ?.question ===
+              "string" &&
+            gap.question.trim()
+        )
+        .map(
+          (gap: any) => ({
+            competency:
+              gap.competency.trim(),
+
+            reason:
+              typeof gap
+                .reason ===
+              "string"
+                ? gap.reason.trim()
+                : "Additional evidence is required.",
+
+            question:
+              gap.question.trim(),
+          })
+        ),
+  };
+}
