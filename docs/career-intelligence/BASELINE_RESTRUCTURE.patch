-
-    if (
-      evaluation.status ===
-      "demonstrated"
-    ) {
-      await stageCapability(
-        {
-          roleAssessmentId,
-
-          competencyId:
-            canonical
-              ? String(
-                  canonical.id
-                )
-              : null,
-
-          name:
-            canonical
-              ? String(
-                  canonical.name
-                )
-              : evaluation.competency,
-
-          sourceType:
-            "clarification",
-
-          evidence:
-            evaluation.evidence,
-
-          confidence:
-            evaluation.confidence,
-
-          demonstrated:
-            true,
-
-          capabilityStatus:
-            "demonstrated",
-
-          assessmentStatus:
-            "assessed",
-        }
-      );
-    }
-
-    if (
-      evaluation.status ===
-      "gap"
-    ) {
-      await stageCapability(
-        {
-          roleAssessmentId,
-
-          competencyId:
-            canonical
-              ? String(
-                  canonical.id
-                )
-              : null,
-
-          name:
-            canonical
-              ? String(
-                  canonical.name
-                )
-              : evaluation.competency,
-
-          sourceType:
