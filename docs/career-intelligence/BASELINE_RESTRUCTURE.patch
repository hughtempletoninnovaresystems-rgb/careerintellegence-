-function normaliseCVDate(
-  value: unknown,
-  isToDate = false
-): {
-  date: string;
-  precision: DatePrecision;
-  original: string;
-} {
-  if (
-    typeof value !==
-      "string" ||
-    !value.trim()
-  ) {
-    return {
-      date: "",
-      precision: "unknown",
-      original: "",
-    };
-  }
-
-  const original =
-    value.trim();
-
-  if (
-    isToDate &&
-    /^(present|current|ongoing|now|today)$/i.test(
-      original
-    )
-  ) {
-    return {
-      date: "",
-      precision: "ongoing",
-      original,
-    };
-  }
-
-  if (
-    /^\d{4}-\d{2}-\d{2}$/.test(
-      original
-    )
-  ) {
-    return {
-      date: original,
-      precision: "day",
-      original,
-    };
-  }
-
-  const isoMonth =
-    original.match(
-      /^(\d{4})-(\d{1,2})$/
-    );
-
-  if (isoMonth) {
-    return {
-      date:
-        `${isoMonth[1]}-${isoMonth[2].padStart(
-          2,
-          "0"
-        )}-01`,
-
-      precision: "month",
-      original,
-    };
-  }
-
-  if (
-    /^\d{4}$/.test(
-      original
-    )
-  ) {
-    return {
-      date:
-        `${original}-01-01`,
-
-      precision: "year",
-      original,
-    };
-  }
-
-  const monthYear =
-    original.match(
-      /^([A-Za-z]+)[\s/-]+(\d{4})$/
-    );
-
-  if (monthYear) {
-    const month =
-      monthNumber(
-        monthYear[1]
-      );
-
-    if (month) {
-      return {
-        date:
-          `${monthYear[2]}-${month}-01`,
-
-        precision: "month",
-        original,
-      };
-    }
-  }
-
-  const yearMonthName =
-    original.match(
-      /^(\d{4})[\s/-]+([A-Za-z]+)$/
-    );
-
-  if (yearMonthName) {
-    const month =
-      monthNumber(
-        yearMonthName[2]
-      );
-
-    if (month) {
-      return {
-        date:
-          `${yearMonthName[1]}-${month}-01`,
-
-        precision: "month",
-        original,
-      };
-    }
-  }
-
-  const parsed =
-    new Date(original);
-
-  if (
-    !Number.isNaN(
-      parsed.getTime()
-    )
-  ) {
-    return {
-      date:
-        parsed
-          .toISOString()
-          .slice(0, 10),
-
-      precision: "day",
-      original,
-    };
-  }
-
-  return {
-    date: "",
-    precision: "unknown",
-    original,
-  };
-}
-
-function formatDateForInput(
-  value: unknown
-) {
-  if (!value) {
-    return "";
-  }
-
-  if (
-    typeof value ===
-    "string"
-  ) {
-    const match =
-      value.match(
-        /^(\d{4}-\d{2}-\d{2})/
-      );
-
-    if (match) {
-      return match[1];
-    }
-  }
-
-  const date =
-    value instanceof Date
-      ? value
-      : new Date(
-          String(value)
-        );
-
-  if (
-    Number.isNaN(
-      date.getTime()
-    )
-  ) {
-    return "";
-  }
-
-  return date
-    .toISOString()
-    .slice(0, 10);
-}
