+-  assessmentId: string,
+-  sequenceNo: number,
+-  role: ManualRoleInput,
+-  canonicalRoleId:
+-    | string
+-    | null,
+-  lifecycleStatus:
+-    | "in_progress"
+-    | "not_started"
+-) {
+-  const current =
+-    role.toDatePrecision ===
+-    "ongoing";
+-
+-  const result =
+-    await sql`
+-      INSERT INTO career_role_assessments (
+-        assessment_id,
+-        sequence_no,
+-        canonical_role_id,
+-        organisation_name,
+-        proposed_role_title,
+-
+-        from_date,
+-        to_date,
+-
+-        from_date_precision,
+-        to_date_precision,
+-
+-        from_date_original,
+-        to_date_original,
+-
+-        role_description,
+-        engagement_model,
+-        employment_context,
+-        lifecycle_status,
+-        updated_at
+-      )
+-      VALUES (
+-        ${assessmentId},
+-        ${sequenceNo},
+-        ${canonicalRoleId},
+-        ${role.organisation},
+-        ${role.roleTitle},
+-
+-        ${role.fromDate || null},
+-
+-        ${
+-          current
+-            ? null
+-            : role.toDate ||
+-              null
+-        },
+-
+-        ${
+-          role.fromDatePrecision ||
+-          (
+-            role.fromDate
+-              ? 'day'
+-              : 'unknown'
+-          )
+-        },
+-
+-        ${
+-          current
+-            ? 'ongoing'
+-            : role.toDatePrecision ||
+-              (
+-                role.toDate
+-                  ? 'day'
+-                  : 'unknown'
+-              )
+-        },
+-
+-        ${
+-          role.fromDateOriginal ||
+-          role.fromDate ||
+-          null
+-        },
+-
+-        ${
+-          current
+-            ? 'Present'
+-            : role.toDateOriginal ||
+-              role.toDate ||
+-              null
+-        },
+-
+-        ${role.description},
+-        ${role.engagementType || null},
+-        ${role.employmentType || null},
+-        ${lifecycleStatus},
+-        NOW()
+-      )
+-      RETURNING id
+-    `;
+-
+-  return String(
+-    result.rows[0].id
+-  );
+-}
