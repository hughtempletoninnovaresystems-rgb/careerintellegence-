+-/* ============================================================
+-   SUBMIT ROLE
+-============================================================ */
+-
+-async function handleSubmitRole(
+-  body: any,
+-  userId: string
+-) {
+-  const roleAssessmentId =
+-    String(
+-      body.roleAssessmentId ||
+-        ""
+-    );
+-
+-  const assessmentId =
+-    await verifyRoleOwnership(
+-      roleAssessmentId,
+-      userId
+-    );
