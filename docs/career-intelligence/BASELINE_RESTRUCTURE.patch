++              true
++            );
++
++          const capabilities =
++            Array.isArray(
++              role.capabilities
++            )
++              ? role.capabilities
++              : [];
++
++          return {
++            organisationName:
++              typeof role
++                .organisationName ===
++              "string"
++                ? role.organisationName.trim()
++                : "",
++
++            roleTitle:
++              role.roleTitle.trim(),
++
++            fromDate:
++              from.date,
++
++            toDate:
++              to.date,
++
++            fromDatePrecision:
++              from.precision,
++
++            toDatePrecision:
++              to.precision,
++
++            fromDateOriginal:
++              from.original,
++
++            toDateOriginal:
++              to.original,
++
++            roleDescription:
++              typeof role
++                .roleDescription ===
++              "string"
++                ? role.roleDescription.trim()
++                : "",
++
++            engagementModel:
++              typeof role
++                .engagementModel ===
++              "string"
++                ? role.engagementModel.trim()
++                : "",
++
++            employmentContext:
++              typeof role
++                .employmentContext ===
++              "string"
++                ? role.employmentContext.trim()
++                : "",
++
++            capabilities:
++              capabilities
++                .filter(
++                  (capability: any) =>
++                    typeof capability
++                      ?.name ===
++                      "string" &&
++                    capability.name.trim()
++                )
++                .map(
++                  (
++                    capability: any
++                  ) => ({
++                    name:
++                      capability.name.trim(),
++
++                    evidence:
++                      typeof capability
++                        .evidence ===
++                      "string"
++                        ? capability.evidence.trim()
++                        : "",
++
++                    confidence:
++                      clamp(
++                        Number(
++                          capability.confidence ??
++                            0
++                        )
++                      ),
++                  })
++                ),
++          };
++        }
++      );
++
++  return {
++    candidateName:
++      typeof parsed
